+
+unsigned short setMVCmd (unsigned short op, unsigned short devAddr, unsigned short regAddr) 
+{ 
+ unsigned short retCmd = 0x9000; 
+ 
+ retCmd |= op<<10; 
+ retCmd |= (devAddr&0x1F)<<5; 
+ retCmd |= (regAddr&0x1F); 
+ 
+ return retCmd; 
+} 
+ 
+int writeMVreg (const char *devname, unsigned char dev, unsigned char addr, unsigned char reg, 
+    unsigned short value) 
+{ 
+ unsigned short cmd; 
+ cmd = setMVCmd(MV_SMI_OP_WR, addr, reg); 
+ if(miiphy_write(devname, dev, MV_SMI_DATA_REG, value)) return 1; 
+ if(miiphy_write(devname, dev, MV_SMI_CMD_REG, cmd)) return 1; 
+ 
+ //printf("%s(%s,0x%X,0x%X,0x%X)\n", __func__, devname, dev, addr, value); 
+} 
+ 
+int readMVreg (const char *devname, unsigned char dev, unsigned char addr, unsigned char reg, 
+    unsigned short *value) 
+{ 
+ unsigned short cmd; 
+ 
+ cmd = setMVCmd(MV_SMI_OP_RD, addr, reg); 
+ if(miiphy_write(devname, dev, MV_SMI_CMD_REG, cmd)) return 1; 
+ if(miiphy_read(devname, dev, MV_SMI_DATA_REG, value)) return 1; 
+ 
+ //printf("%s(%s,0x%X,0x%X,0x%X)\n", __func__, devname, dev, addr, *value); 
+ 
+ return 0; 
+} 
+ 
+int setMVregbit (const char *devname, unsigned char dev, unsigned char addr, unsigned char reg, 
+    unsigned short value) 
+{ 
+ unsigned short data; 
+ 
+ if (readMVreg(devname, dev, addr, reg, &data)) return 1; 
+ data |= value; 
+ if (writeMVreg(devname, dev, addr, reg, data)) return 1; 
+ 
+ return 0; 
+} 
+ 
+int clearMVregbit (const char *devname, unsigned char dev, unsigned char addr, unsigned char reg, 
+    unsigned short value) 
+{ 
+ unsigned short data; 
+ 
+ if (readMVreg(devname, dev, addr, reg, &data)) return 1; 
+ data &= ~value; 
+ if (writeMVreg(devname, dev, addr, reg, data)) return 1; 
+ 
+ return 0; 
+} 
+ 
+
+
+int switch_setup(void) 
+{ 
+ int ret; 
+ unsigned short val=0; 
+ 
+ ret = miiphy_read(MV_CORE_0_SMI, MV_CORE_0_ADDR, MV_SMI_DATA_REG, &val); 
+ 
+ if (ret||(val>0)) { 
+  printf("MV88Q5192#0 Initial fail!\n"); 
+ } else { 
+  setMVregbit(MV_CORE_0_SMI, MV_CORE_0_ADDR, 0x7, 0x1, 0xC000); 
+ } 
+ 
+ ret = miiphy_read(MV_CORE_1_SMI, MV_CORE_1_ADDR, MV_SMI_DATA_REG, &val); 
+ 
+ if (ret||(val>0)) { 
+  printf("MV88Q5192#1 Initial fail!\n"); 
+            } else { 
+     setMVregbit(MV_CORE_1_SMI, MV_CORE_1_ADDR, 0x7, 0x1, 0xC000); 
+    } 
+ 
+ return 0; 
+} 
+
