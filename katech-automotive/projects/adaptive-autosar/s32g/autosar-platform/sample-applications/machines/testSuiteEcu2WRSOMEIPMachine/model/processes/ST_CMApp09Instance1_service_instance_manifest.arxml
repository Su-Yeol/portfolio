<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00052.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>apd</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>Machines</SHORT-NAME>
          <AR-PACKAGES>
            <AR-PACKAGE>
              <SHORT-NAME>testSuiteEcu2WRSOMEIPMachine</SHORT-NAME>
              <AR-PACKAGES>
                <AR-PACKAGE>
                  <!-- ServiceInstanceToMachineMappings -->
                  <SHORT-NAME>ServiceInstanceToMachineMappings</SHORT-NAME>
                  <ELEMENTS>
                    <SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                      <!-- CMApp09DiagRoutineProvidedServiceInstanceToEcu2Machine -->
                      <SHORT-NAME>CMApp09DiagRoutineProvidedServiceInstanceToEcu2Machine</SHORT-NAME>
                      <COMMUNICATION-CONNECTOR-REF DEST="ETHERNET-COMMUNICATION-CONNECTOR">/apd/MachineDesigns/testSuiteEcu2WRSOMEIPMachineDesign/CommunicationWRSOMEIPConnector1</COMMUNICATION-CONNECTOR-REF>
                      <SERVICE-INSTANCE-REFS>
                        <SERVICE-INSTANCE-REF DEST="PROVIDED-SOMEIP-SERVICE-INSTANCE">/apd/Machines/testSuiteEcu2WRSOMEIPMachine/ServiceInstances/ST_CMApp09DiagRoutineProvidedSomeipServiceInstance</SERVICE-INSTANCE-REF>
                      </SERVICE-INSTANCE-REFS>
                      <UDP-PORT-REF DEST="AP-APPLICATION-ENDPOINT">/apd/MachineDesigns/testSuiteEcu2WRSOMEIPMachineDesign/CommunicationWRSOMEIPConnector1/ST_CMApp09DiagRoutineApplicationEndpoint</UDP-PORT-REF>
                    </SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                    <SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                      <!-- CMService5ProvidedServiceInstanceToEcu2Machine -->
                      <SHORT-NAME>CMService5ProvidedServiceInstanceToEcu2Machine</SHORT-NAME>
                      <COMMUNICATION-CONNECTOR-REF DEST="ETHERNET-COMMUNICATION-CONNECTOR">/apd/MachineDesigns/testSuiteEcu2WRSOMEIPMachineDesign/CommunicationWRSOMEIPConnector1</COMMUNICATION-CONNECTOR-REF>
                      <SERVICE-INSTANCE-REFS>
                        <SERVICE-INSTANCE-REF DEST="PROVIDED-SOMEIP-SERVICE-INSTANCE">/apd/Machines/testSuiteEcu2WRSOMEIPMachine/ServiceInstances/ST_CMService5ProvidedSomeipServiceInstance</SERVICE-INSTANCE-REF>
                      </SERVICE-INSTANCE-REFS>
                      <UDP-PORT-REF DEST="AP-APPLICATION-ENDPOINT">/apd/MachineDesigns/testSuiteEcu2WRSOMEIPMachineDesign/CommunicationWRSOMEIPConnector1/CMService5ApplicationEndpoint</UDP-PORT-REF>
                    </SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                  </ELEMENTS>
                </AR-PACKAGE>
                <AR-PACKAGE>
                  <!-- ServiceInstances -->
                  <SHORT-NAME>ServiceInstances</SHORT-NAME>
                  <ELEMENTS>
                    <PROVIDED-SOMEIP-SERVICE-INSTANCE>
                      <!-- ST_CMApp09DiagRoutineProvidedSomeipServiceInstance -->
                      <SHORT-NAME>ST_CMApp09DiagRoutineProvidedSomeipServiceInstance</SHORT-NAME>
                      <SERVICE-INTERFACE-DEPLOYMENT-REF DEST="SOMEIP-SERVICE-INTERFACE-DEPLOYMENT">/apd/ServiceInterfaceDeployments/RoutineService_Someip</SERVICE-INTERFACE-DEPLOYMENT-REF>
                      <SD-SERVER-CONFIG-REF DEST="SOMEIP-SD-SERVER-SERVICE-INSTANCE-CONFIG">/apd/SomeipSdTimingConfigs/SomeipSdServerServiceInstanceConfig</SD-SERVER-CONFIG-REF>
                      <SERVICE-INSTANCE-ID>1730</SERVICE-INSTANCE-ID>
                    </PROVIDED-SOMEIP-SERVICE-INSTANCE>
                    <PROVIDED-SOMEIP-SERVICE-INSTANCE>
                      <!-- ST_CMService5ProvidedSomeipServiceInstance -->
                      <SHORT-NAME>ST_CMService5ProvidedSomeipServiceInstance</SHORT-NAME>
                      <SERVICE-INTERFACE-DEPLOYMENT-REF DEST="SOMEIP-SERVICE-INTERFACE-DEPLOYMENT">/apd/ServiceInterfaceDeployments/CMService5_Someip</SERVICE-INTERFACE-DEPLOYMENT-REF>
                      <SD-SERVER-CONFIG-REF DEST="SOMEIP-SD-SERVER-SERVICE-INSTANCE-CONFIG">/apd/SomeipSdTimingConfigs/SomeipSdServerServiceInstanceConfig</SD-SERVER-CONFIG-REF>
                      <SERVICE-INSTANCE-ID>25</SERVICE-INSTANCE-ID>
                    </PROVIDED-SOMEIP-SERVICE-INSTANCE>
                  </ELEMENTS>
                </AR-PACKAGE>
              </AR-PACKAGES>
            </AR-PACKAGE>
          </AR-PACKAGES>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
