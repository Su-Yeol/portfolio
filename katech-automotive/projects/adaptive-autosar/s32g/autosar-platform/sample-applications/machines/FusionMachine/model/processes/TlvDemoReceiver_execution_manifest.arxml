<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00052.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>apd</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>Machines</SHORT-NAME>
          <AR-PACKAGES>
            <AR-PACKAGE>
              <SHORT-NAME>FusionMachine</SHORT-NAME>
              <AR-PACKAGES>
                <AR-PACKAGE>
                  <SHORT-NAME>ProcessToMachineMappings</SHORT-NAME>
                  <ELEMENTS>
                    <PROCESS-TO-MACHINE-MAPPING-SET>
                      <SHORT-NAME>TlvDemoReceiver</SHORT-NAME>
                      <PROCESS-TO-MACHINE-MAPPINGS>
                        <PROCESS-TO-MACHINE-MAPPING>
                          <SHORT-NAME>TlvDemoReceiver</SHORT-NAME>
                          <MACHINE-REF DEST="MACHINE">/apd/Machines/FusionMachine/FusionMachine</MACHINE-REF>
                          <PROCESS-REF DEST="PROCESS">/apd/Machines/FusionMachine/Processes/TlvDemoReceiver</PROCESS-REF>
                        </PROCESS-TO-MACHINE-MAPPING>
                      </PROCESS-TO-MACHINE-MAPPINGS>
                    </PROCESS-TO-MACHINE-MAPPING-SET>
                  </ELEMENTS>
                </AR-PACKAGE>
                <AR-PACKAGE>
                  <SHORT-NAME>Dlt</SHORT-NAME>
                  <ELEMENTS>
                    <DLT-APPLICATION-TO-PROCESS-MAPPING>
                      <SHORT-NAME>TlvDemoReceiverDltApplicationToProcessMapping</SHORT-NAME>
                      <DLT-APPLICATION-REF DEST="DLT-APPLICATION">/apd/Machines/FusionMachine/Dlt/FusionMachineDltEcu/TlvDemoReceiverApplication</DLT-APPLICATION-REF>
                      <PROCESS-REF DEST="PROCESS">/apd/Machines/FusionMachine/Processes/TlvDemoReceiver</PROCESS-REF>
                    </DLT-APPLICATION-TO-PROCESS-MAPPING>
                    <DLT-LOG-SINK-TO-PORT-PROTOTYPE-MAPPING>
                      <SHORT-NAME>TlvDemoReceiverDltLogSinkToPortPrototypeMapping</SHORT-NAME>
                      <DLT-CONTEXT-REF DEST="DLT-CONTEXT">/apd/Dlt/DefaultDltContext</DLT-CONTEXT-REF>
                      <DLT-LOG-SINK-REFS>
                        <DLT-LOG-SINK-REF DEST="DLT-LOG-SINK">/apd/Machines/FusionMachine/Dlt/ConsoleDltSink</DLT-LOG-SINK-REF>
                        <DLT-LOG-SINK-REF DEST="DLT-LOG-SINK">/apd/Dlt/RemoteDltSink</DLT-LOG-SINK-REF>
                        <DLT-LOG-SINK-REF DEST="DLT-LOG-SINK">/apd/Dlt/TlvDemoReceiverFileDltSink</DLT-LOG-SINK-REF>
                      </DLT-LOG-SINK-REFS>
                      <PROCESS-REF DEST="PROCESS">/apd/Machines/FusionMachine/Processes/TlvDemoReceiver</PROCESS-REF>
                    </DLT-LOG-SINK-TO-PORT-PROTOTYPE-MAPPING>
                  </ELEMENTS>
                </AR-PACKAGE>
                <AR-PACKAGE>
                  <SHORT-NAME>Processes</SHORT-NAME>
                  <ELEMENTS>
                    <PROCESS>
                      <SHORT-NAME>TlvDemoReceiver</SHORT-NAME>
                      <DESIGN-REF DEST="PROCESS-DESIGN">/apd/Machines/FusionMachine/ProcessDesigns/TlvDemoReceiver</DESIGN-REF>
                      <EXECUTABLE-REFS>
                        <EXECUTABLE-REF DEST="EXECUTABLE">/apd/Executables/TlvDemoReceiver</EXECUTABLE-REF>
                      </EXECUTABLE-REFS>
                      <PROCESS-STATE-MACHINE>
                        <SHORT-NAME>state_machine</SHORT-NAME>
                        <TYPE-TREF DEST="MODE-DECLARATION-GROUP">/apd/ModeDeclarationGroups/ProcessStateMachine</TYPE-TREF>
                      </PROCESS-STATE-MACHINE>
                      <STATE-DEPENDENT-STARTUP-CONFIGS>
                        <STATE-DEPENDENT-STARTUP-CONFIG>
                          <FUNCTION-GROUP-STATE-IREFS>
                            <FUNCTION-GROUP-STATE-IREF>
                              <CONTEXT-MODE-DECLARATION-GROUP-PROTOTYPE-REF DEST="MODE-DECLARATION-GROUP-PROTOTYPE">/apd/Machines/FusionMachine/FunctionGroupSets/FusionFunctionGroups/MachineFG</CONTEXT-MODE-DECLARATION-GROUP-PROTOTYPE-REF>
                              <TARGET-MODE-DECLARATION-REF DEST="MODE-DECLARATION">/apd/ModeDeclarationGroups/MachineState/Driving</TARGET-MODE-DECLARATION-REF>
                            </FUNCTION-GROUP-STATE-IREF>
                          </FUNCTION-GROUP-STATE-IREFS>
                          <RESOURCE-GROUP-REF DEST="RESOURCE-GROUP">/apd/Machines/FusionMachine/FusionMachine/Linux/ResourceGroup1</RESOURCE-GROUP-REF>
                          <STARTUP-CONFIG-REF DEST="STARTUP-CONFIG">/apd/Machines/FusionMachine/StartupConfigSets/TlvDemoReceiverStartup</STARTUP-CONFIG-REF>
                        </STATE-DEPENDENT-STARTUP-CONFIG>
                      </STATE-DEPENDENT-STARTUP-CONFIGS>
                    </PROCESS>
                  </ELEMENTS>
                </AR-PACKAGE>
                <AR-PACKAGE>
                  <SHORT-NAME>ServiceInstanceToPortPrototypeMappings</SHORT-NAME>
                  <ELEMENTS>
                    <SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                      <SHORT-NAME>tlv_RequiredServiceInstance_toPort</SHORT-NAME>
                      <PORT-PROTOTYPE-IREF>
                        <TARGET-PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/apd/AdaptiveApplicationSwComponentTypes/TlvDemoReceiver/tlv_RPort</TARGET-PORT-PROTOTYPE-REF>
                      </PORT-PROTOTYPE-IREF>
                      <PROCESS-REF DEST="PROCESS">/apd/Machines/FusionMachine/Processes/TlvDemoReceiver</PROCESS-REF>
                      <SERVICE-INSTANCE-REF DEST="REQUIRED-SOMEIP-SERVICE-INSTANCE">/apd/Machines/FusionMachine/ServiceInstances/TlvRequiredSomeipServiceInstance</SERVICE-INSTANCE-REF>
                    </SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                  </ELEMENTS>
                </AR-PACKAGE>
                <AR-PACKAGE>
                  <SHORT-NAME>StartupConfigSets</SHORT-NAME>
                  <ELEMENTS>
                    <STARTUP-CONFIG>
                      <SHORT-NAME>TlvDemoReceiverStartup</SHORT-NAME>
                      <ENVIRONMENT-VARIABLES>
                        <TAG-WITH-OPTIONAL-VALUE>
                          <KEY>VSOMEIP_CONFIGURATION</KEY>
                          <VALUE>/etc/vsomeip.json</VALUE>
                        </TAG-WITH-OPTIONAL-VALUE>
                      </ENVIRONMENT-VARIABLES>
                      <SCHEDULING-POLICY>SCHEDULING-POLICY-ROUND-ROBIN</SCHEDULING-POLICY>
                      <SCHEDULING-PRIORITY>12</SCHEDULING-PRIORITY>
                      <TERMINATION-BEHAVIOR>PROCESS-IS-NOT-SELF-TERMINATING</TERMINATION-BEHAVIOR>
                    </STARTUP-CONFIG>
                  </ELEMENTS>
                </AR-PACKAGE>
              </AR-PACKAGES>
            </AR-PACKAGE>
          </AR-PACKAGES>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
