<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00052.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>apd</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>Machines</SHORT-NAME>
          <AR-PACKAGES>
            <AR-PACKAGE>
              <SHORT-NAME>RadarFusionMachine</SHORT-NAME>
              <AR-PACKAGES>
                <AR-PACKAGE>
                  <SHORT-NAME>ProcessToMachineMappings</SHORT-NAME>
                  <ELEMENTS>
                    <PROCESS-TO-MACHINE-MAPPING-SET>
                      <SHORT-NAME>StateManager</SHORT-NAME>
                      <PROCESS-TO-MACHINE-MAPPINGS>
                        <PROCESS-TO-MACHINE-MAPPING>
                          <SHORT-NAME>StateManager</SHORT-NAME>
                          <MACHINE-REF DEST="MACHINE">/apd/Machines/RadarFusionMachine/RadarFusionMachine</MACHINE-REF>
                          <PROCESS-REF DEST="PROCESS">/apd/Machines/RadarFusionMachine/Processes/StateManager</PROCESS-REF>
                        </PROCESS-TO-MACHINE-MAPPING>
                      </PROCESS-TO-MACHINE-MAPPINGS>
                    </PROCESS-TO-MACHINE-MAPPING-SET>
                  </ELEMENTS>
                </AR-PACKAGE>
                <AR-PACKAGE>
                  <SHORT-NAME>DltLogChannelToProcessMappings</SHORT-NAME>
                  <ELEMENTS>
                    <DLT-APPLICATION-TO-PROCESS-MAPPING>
                      <SHORT-NAME>StateManagerDltApplicationToProcessMapping</SHORT-NAME>
                      <DLT-APPLICATION-REF DEST="DLT-APPLICATION">/apd/Machines/RadarFusionMachine/Dlt/RadarFusionDltEcu/StateManagerApplication</DLT-APPLICATION-REF>
                      <PROCESS-REF DEST="PROCESS">/apd/Machines/RadarFusionMachine/Processes/StateManager</PROCESS-REF>
                    </DLT-APPLICATION-TO-PROCESS-MAPPING>
                    <DLT-LOG-SINK-TO-PORT-PROTOTYPE-MAPPING>
                      <SHORT-NAME>StateManagerDltLogSinkToPortPrototypeMapping</SHORT-NAME>
                      <DLT-CONTEXT-REF DEST="DLT-CONTEXT">/apd/Dlt/DefaultDltContext</DLT-CONTEXT-REF>
                      <DLT-LOG-SINK-REFS>
                        <DLT-LOG-SINK-REF DEST="DLT-LOG-SINK">/apd/Machines/RadarFusionMachine/Dlt/ConsoleDltSink</DLT-LOG-SINK-REF>
                        <DLT-LOG-SINK-REF DEST="DLT-LOG-SINK">/apd/Dlt/RemoteDltSink</DLT-LOG-SINK-REF>
                        <DLT-LOG-SINK-REF DEST="DLT-LOG-SINK">/apd/Dlt/StateManagerFileDltSink</DLT-LOG-SINK-REF>
                      </DLT-LOG-SINK-REFS>
                      <PROCESS-REF DEST="PROCESS">/apd/Machines/RadarFusionMachine/Processes/StateManager</PROCESS-REF>
                    </DLT-LOG-SINK-TO-PORT-PROTOTYPE-MAPPING>
                  </ELEMENTS>
                </AR-PACKAGE>
                <AR-PACKAGE>
                  <SHORT-NAME>Processes</SHORT-NAME>
                  <ELEMENTS>
                    <PROCESS>
                      <SHORT-NAME>StateManager</SHORT-NAME>
                      <DESIGN-REF DEST="PROCESS-DESIGN">/apd/Machines/RadarFusionMachine/ProcessDesigns/StateManager</DESIGN-REF>
                      <EXECUTABLE-REFS>
                        <EXECUTABLE-REF DEST="EXECUTABLE">/apd/Executables/StateManager</EXECUTABLE-REF>
                      </EXECUTABLE-REFS>
                      <FUNCTION-CLUSTER-AFFILIATION>STATE_MANAGEMENT</FUNCTION-CLUSTER-AFFILIATION>
                      <PROCESS-STATE-MACHINE>
                        <SHORT-NAME>state_machine</SHORT-NAME>
                        <TYPE-TREF DEST="MODE-DECLARATION-GROUP">/apd/ModeDeclarationGroups/ProcessStateMachine</TYPE-TREF>
                      </PROCESS-STATE-MACHINE>
                      <STATE-DEPENDENT-STARTUP-CONFIGS>
                        <STATE-DEPENDENT-STARTUP-CONFIG>
                          <FUNCTION-GROUP-STATE-IREFS>
                            <FUNCTION-GROUP-STATE-IREF>
                              <CONTEXT-MODE-DECLARATION-GROUP-PROTOTYPE-REF DEST="MODE-DECLARATION-GROUP-PROTOTYPE">/apd/Machines/RadarFusionMachine/FunctionGroupSets/RadarFusionFunctionGroups/MachineFG</CONTEXT-MODE-DECLARATION-GROUP-PROTOTYPE-REF>
                              <TARGET-MODE-DECLARATION-REF DEST="MODE-DECLARATION">/apd/ModeDeclarationGroups/MachineState/Startup</TARGET-MODE-DECLARATION-REF>
                            </FUNCTION-GROUP-STATE-IREF>
                            <FUNCTION-GROUP-STATE-IREF>
                              <CONTEXT-MODE-DECLARATION-GROUP-PROTOTYPE-REF DEST="MODE-DECLARATION-GROUP-PROTOTYPE">/apd/Machines/RadarFusionMachine/FunctionGroupSets/RadarFusionFunctionGroups/MachineFG</CONTEXT-MODE-DECLARATION-GROUP-PROTOTYPE-REF>
                              <TARGET-MODE-DECLARATION-REF DEST="MODE-DECLARATION">/apd/ModeDeclarationGroups/MachineState/Driving</TARGET-MODE-DECLARATION-REF>
                            </FUNCTION-GROUP-STATE-IREF>
                            <FUNCTION-GROUP-STATE-IREF>
                              <CONTEXT-MODE-DECLARATION-GROUP-PROTOTYPE-REF DEST="MODE-DECLARATION-GROUP-PROTOTYPE">/apd/Machines/RadarFusionMachine/FunctionGroupSets/RadarFusionFunctionGroups/MachineFG</CONTEXT-MODE-DECLARATION-GROUP-PROTOTYPE-REF>
                              <TARGET-MODE-DECLARATION-REF DEST="MODE-DECLARATION">/apd/ModeDeclarationGroups/MachineState/Shutdown</TARGET-MODE-DECLARATION-REF>
                            </FUNCTION-GROUP-STATE-IREF>
                            <FUNCTION-GROUP-STATE-IREF>
                              <CONTEXT-MODE-DECLARATION-GROUP-PROTOTYPE-REF DEST="MODE-DECLARATION-GROUP-PROTOTYPE">/apd/Machines/RadarFusionMachine/FunctionGroupSets/RadarFusionFunctionGroups/MachineFG</CONTEXT-MODE-DECLARATION-GROUP-PROTOTYPE-REF>
                              <TARGET-MODE-DECLARATION-REF DEST="MODE-DECLARATION">/apd/ModeDeclarationGroups/MachineState/Restart</TARGET-MODE-DECLARATION-REF>
                            </FUNCTION-GROUP-STATE-IREF>
                            <FUNCTION-GROUP-STATE-IREF>
                              <CONTEXT-MODE-DECLARATION-GROUP-PROTOTYPE-REF DEST="MODE-DECLARATION-GROUP-PROTOTYPE">/apd/Machines/RadarFusionMachine/FunctionGroupSets/RadarFusionFunctionGroups/MachineFG</CONTEXT-MODE-DECLARATION-GROUP-PROTOTYPE-REF>
                              <TARGET-MODE-DECLARATION-REF DEST="MODE-DECLARATION">/apd/ModeDeclarationGroups/MachineState/Parking</TARGET-MODE-DECLARATION-REF>
                            </FUNCTION-GROUP-STATE-IREF>
                            <FUNCTION-GROUP-STATE-IREF>
                              <CONTEXT-MODE-DECLARATION-GROUP-PROTOTYPE-REF DEST="MODE-DECLARATION-GROUP-PROTOTYPE">/apd/Machines/RadarFusionMachine/FunctionGroupSets/RadarFusionFunctionGroups/MachineFG</CONTEXT-MODE-DECLARATION-GROUP-PROTOTYPE-REF>
                              <TARGET-MODE-DECLARATION-REF DEST="MODE-DECLARATION">/apd/ModeDeclarationGroups/MachineState/Leaving</TARGET-MODE-DECLARATION-REF>
                            </FUNCTION-GROUP-STATE-IREF>
                          </FUNCTION-GROUP-STATE-IREFS>
                          <RESOURCE-GROUP-REF DEST="RESOURCE-GROUP">/apd/Machines/RadarFusionMachine/RadarFusionMachine/Linux/ResourceGroupSM</RESOURCE-GROUP-REF>
                          <STARTUP-CONFIG-REF DEST="STARTUP-CONFIG">/apd/Machines/RadarFusionMachine/StartupConfigSets/StateManager</STARTUP-CONFIG-REF>
                        </STATE-DEPENDENT-STARTUP-CONFIG>
                      </STATE-DEPENDENT-STARTUP-CONFIGS>
                    </PROCESS>
                  </ELEMENTS>
                </AR-PACKAGE>
                <AR-PACKAGE>
                  <SHORT-NAME>ServiceInstanceToPortPrototypeMappings</SHORT-NAME>
                  <ELEMENTS>
                    <SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                      <SHORT-NAME>RoutineService_ProvidedServiceInterface_toPort</SHORT-NAME>
                      <PORT-PROTOTYPE-IREF>
                        <TARGET-PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/apd/AdaptiveApplicationSwComponentTypes/StateManager/RoutineService_PPort</TARGET-PORT-PROTOTYPE-REF>
                      </PORT-PROTOTYPE-IREF>
                      <PROCESS-REF DEST="PROCESS">/apd/Machines/RadarFusionMachine/Processes/StateManager</PROCESS-REF>
                      <SERVICE-INSTANCE-REF DEST="PROVIDED-SOMEIP-SERVICE-INSTANCE">/apd/Machines/RadarFusionMachine/ServiceInstances/RoutineService_ProvidedSomeipServiceInstance</SERVICE-INSTANCE-REF>
                    </SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                    <SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                      <SHORT-NAME>UpdateAllowedService_ProvidedServiceInterface_toPort</SHORT-NAME>
                      <PORT-PROTOTYPE-IREF>
                        <TARGET-PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/apd/AdaptiveApplicationSwComponentTypes/StateManager/UpdateAllowedService_PPort</TARGET-PORT-PROTOTYPE-REF>
                      </PORT-PROTOTYPE-IREF>
                      <PROCESS-REF DEST="PROCESS">/apd/Machines/RadarFusionMachine/Processes/StateManager</PROCESS-REF>
                      <SERVICE-INSTANCE-REF DEST="PROVIDED-SOMEIP-SERVICE-INSTANCE">/apd/Machines/RadarFusionMachine/ServiceInstances/UpdateAllowedService_ProvidedSomeipServiceInstance</SERVICE-INSTANCE-REF>
                    </SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                    <SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                      <SHORT-NAME>UpdateRequest_ProvidedServiceInterface_toPort</SHORT-NAME>
                      <PORT-PROTOTYPE-IREF>
                        <TARGET-PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/apd/AdaptiveApplicationSwComponentTypes/StateManager/UpdateRequest_PPort</TARGET-PORT-PROTOTYPE-REF>
                      </PORT-PROTOTYPE-IREF>
                      <PROCESS-REF DEST="PROCESS">/apd/Machines/RadarFusionMachine/Processes/StateManager</PROCESS-REF>
                      <SERVICE-INSTANCE-REF DEST="PROVIDED-SOMEIP-SERVICE-INSTANCE">/apd/Machines/RadarFusionMachine/ServiceInstances/UpdateRequest_ProvidedSomeipServiceInstance</SERVICE-INSTANCE-REF>
                    </SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                    <SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                      <SHORT-NAME>StateMachineService_ProvidedServiceInterface_toPort</SHORT-NAME>
                      <PORT-PROTOTYPE-IREF>
                        <TARGET-PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/apd/AdaptiveApplicationSwComponentTypes/StateManager/StateMachineService_PPort</TARGET-PORT-PROTOTYPE-REF>
                      </PORT-PROTOTYPE-IREF>
                      <PROCESS-REF DEST="PROCESS">/apd/Machines/RadarFusionMachine/Processes/StateManager</PROCESS-REF>
                      <SERVICE-INSTANCE-REF DEST="PROVIDED-SOMEIP-SERVICE-INSTANCE">/apd/Machines/RadarFusionMachine/ServiceInstances/StateMachineService_ProvidedSomeipServiceInstance</SERVICE-INSTANCE-REF>
                    </SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                    <SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                      <SHORT-NAME>TriggerInOut_ProvidedServiceInstance_toPort</SHORT-NAME>
                      <PORT-PROTOTYPE-IREF>
                        <TARGET-PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/apd/AdaptiveApplicationSwComponentTypes/StateManager/TriggerInOut_PPort</TARGET-PORT-PROTOTYPE-REF>
                      </PORT-PROTOTYPE-IREF>
                      <PROCESS-REF DEST="PROCESS">/apd/Machines/RadarFusionMachine/Processes/StateManager</PROCESS-REF>
                      <SERVICE-INSTANCE-REF DEST="PROVIDED-SOMEIP-SERVICE-INSTANCE">/apd/Machines/RadarFusionMachine/ServiceInstances/TriggerInOut_ProvidedSomeipServiceInstance</SERVICE-INSTANCE-REF>
                    </SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                    <SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                      <SHORT-NAME>TriggerIn_ProvidedServiceInstance_toPort</SHORT-NAME>
                      <PORT-PROTOTYPE-IREF>
                        <TARGET-PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/apd/AdaptiveApplicationSwComponentTypes/StateManager/TriggerIn_PPort</TARGET-PORT-PROTOTYPE-REF>
                      </PORT-PROTOTYPE-IREF>
                      <PROCESS-REF DEST="PROCESS">/apd/Machines/RadarFusionMachine/Processes/StateManager</PROCESS-REF>
                      <SERVICE-INSTANCE-REF DEST="PROVIDED-SOMEIP-SERVICE-INSTANCE">/apd/Machines/RadarFusionMachine/ServiceInstances/TriggerIn_ProvidedSomeipServiceInstance</SERVICE-INSTANCE-REF>
                    </SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                    <SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                      <SHORT-NAME>TriggerOut_ProvidedServiceInstance_toPort</SHORT-NAME>
                      <PORT-PROTOTYPE-IREF>
                        <TARGET-PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/apd/AdaptiveApplicationSwComponentTypes/StateManager/TriggerOut_PPort</TARGET-PORT-PROTOTYPE-REF>
                      </PORT-PROTOTYPE-IREF>
                      <PROCESS-REF DEST="PROCESS">/apd/Machines/RadarFusionMachine/Processes/StateManager</PROCESS-REF>
                      <SERVICE-INSTANCE-REF DEST="PROVIDED-SOMEIP-SERVICE-INSTANCE">/apd/Machines/RadarFusionMachine/ServiceInstances/TriggerOut_ProvidedSomeipServiceInstance</SERVICE-INSTANCE-REF>
                    </SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                  </ELEMENTS>
                </AR-PACKAGE>
                <AR-PACKAGE>
                  <SHORT-NAME>StartupConfigSets</SHORT-NAME>
                  <ELEMENTS>
                    <STARTUP-CONFIG>
                      <SHORT-NAME>StateManager</SHORT-NAME>
                      <ENVIRONMENT-VARIABLES>
                        <TAG-WITH-OPTIONAL-VALUE>
                          <KEY>DLT_LOG_MODE</KEY>
                          <VALUE>3</VALUE>
                        </TAG-WITH-OPTIONAL-VALUE>
                      </ENVIRONMENT-VARIABLES>
                      <SCHEDULING-POLICY>SCHEDULING-POLICY-ROUND-ROBIN</SCHEDULING-POLICY>
                      <SCHEDULING-PRIORITY>12</SCHEDULING-PRIORITY>
                      <TERMINATION-BEHAVIOR>PROCESS-IS-NOT-SELF-TERMINATING</TERMINATION-BEHAVIOR>
                    </STARTUP-CONFIG>
                  </ELEMENTS>
                </AR-PACKAGE>
              </AR-PACKAGES>
            </AR-PACKAGE>
          </AR-PACKAGES>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
