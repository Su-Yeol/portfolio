<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://autosar.org/schema/r4.0" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00052.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>adcm</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>Machines</SHORT-NAME>
          <AR-PACKAGES>
            <AR-PACKAGE>
              <SHORT-NAME>AdaptiveMachine</SHORT-NAME>
              <AR-PACKAGES>
                <AR-PACKAGE>
                  <SHORT-NAME>ProcessToMachineMappings</SHORT-NAME>
                  <ELEMENTS>
                    <PROCESS-TO-MACHINE-MAPPING-SET>
                      <SHORT-NAME>Guardian</SHORT-NAME>
                      <PROCESS-TO-MACHINE-MAPPINGS>
                        <PROCESS-TO-MACHINE-MAPPING>
                          <SHORT-NAME>Guardian</SHORT-NAME>
                          <MACHINE-REF DEST="MACHINE">/adcm/Machines/AdaptiveMachine/AdaptiveMachine</MACHINE-REF>
                          <PROCESS-REF DEST="PROCESS">/adcm/Machines/AdaptiveMachine/Processes/Guardian</PROCESS-REF>
                        </PROCESS-TO-MACHINE-MAPPING>
                      </PROCESS-TO-MACHINE-MAPPINGS>
                    </PROCESS-TO-MACHINE-MAPPING-SET>
                  </ELEMENTS>
                </AR-PACKAGE>
                <AR-PACKAGE>
                  <SHORT-NAME>DltLogChannelToProcessMappings</SHORT-NAME>
                  <ELEMENTS>
                    <DLT-APPLICATION-TO-PROCESS-MAPPING>
                      <SHORT-NAME>GuardianDltApplicationToProcessMapping</SHORT-NAME>
                      <DLT-APPLICATION-REF DEST="DLT-APPLICATION">/adcm/Machines/AdaptiveMachine/Dlt/AdcmDltEcu/Guardian</DLT-APPLICATION-REF>
                      <PROCESS-REF DEST="PROCESS">/adcm/Machines/AdaptiveMachine/Processes/Guardian</PROCESS-REF>
                    </DLT-APPLICATION-TO-PROCESS-MAPPING>
                    <DLT-LOG-SINK-TO-PORT-PROTOTYPE-MAPPING>
                      <SHORT-NAME>GuardianDltLogSinkToPortPrototypeMapping</SHORT-NAME>
                      <DLT-CONTEXT-REF DEST="DLT-CONTEXT">/adcm/Machines/AdaptiveMachine/Dlt/DefaultDltContext</DLT-CONTEXT-REF>
                      <DLT-LOG-SINK-REFS>
                        <DLT-LOG-SINK-REF DEST="DLT-LOG-SINK">/adcm/Machines/AdaptiveMachine/Dlt/ConsoleDltSink</DLT-LOG-SINK-REF>
                        <DLT-LOG-SINK-REF DEST="DLT-LOG-SINK">/adcm/Machines/AdaptiveMachine/Dlt/RemoteDltSink</DLT-LOG-SINK-REF>
                        <DLT-LOG-SINK-REF DEST="DLT-LOG-SINK">/adcm/Machines/AdaptiveMachine/Dlt/GuardianFileDltSink</DLT-LOG-SINK-REF>
                      </DLT-LOG-SINK-REFS>
                      <PROCESS-REF DEST="PROCESS">/adcm/Machines/AdaptiveMachine/Processes/Guardian</PROCESS-REF>
                    </DLT-LOG-SINK-TO-PORT-PROTOTYPE-MAPPING>
                  </ELEMENTS>
                </AR-PACKAGE>
                <AR-PACKAGE>
                  <SHORT-NAME>Processes</SHORT-NAME>
                  <ELEMENTS>
                    <PROCESS>
                      <SHORT-NAME>Guardian</SHORT-NAME>
                      <EXECUTABLE-REFS>
                        <EXECUTABLE-REF DEST="EXECUTABLE">/adcm/Executables/Guardian</EXECUTABLE-REF>
                      </EXECUTABLE-REFS>
                      <PROCESS-STATE-MACHINE>
                        <SHORT-NAME>state_machine</SHORT-NAME>
                        <TYPE-TREF DEST="MODE-DECLARATION-GROUP">/adcm/ModeDeclarationGroups/ProcessStateMachine</TYPE-TREF>
                      </PROCESS-STATE-MACHINE>
                      <STATE-DEPENDENT-STARTUP-CONFIGS>
                        <STATE-DEPENDENT-STARTUP-CONFIG>
                          <FUNCTION-GROUP-STATE-IREFS>
                            <FUNCTION-GROUP-STATE-IREF>
                              <CONTEXT-MODE-DECLARATION-GROUP-PROTOTYPE-REF DEST="MODE-DECLARATION-GROUP-PROTOTYPE">/adcm/Machines/AdaptiveMachine/FunctionGroupSets/AdaptiveFunctionGroups/MachineFG</CONTEXT-MODE-DECLARATION-GROUP-PROTOTYPE-REF>
                              <TARGET-MODE-DECLARATION-REF DEST="MODE-DECLARATION">/adcm/ModeDeclarationGroups/MachineState/Driving</TARGET-MODE-DECLARATION-REF>
                            </FUNCTION-GROUP-STATE-IREF>
                          </FUNCTION-GROUP-STATE-IREFS>
                          <RESOURCE-GROUP-REF DEST="RESOURCE-GROUP">/adcm/Machines/AdaptiveMachine/AdaptiveMachine/Linux/ResourceGroupADCM</RESOURCE-GROUP-REF>
                          <STARTUP-CONFIG-REF DEST="STARTUP-CONFIG">/adcm/Machines/AdaptiveMachine/StartupConfigSets/Guardian</STARTUP-CONFIG-REF>
                        </STATE-DEPENDENT-STARTUP-CONFIG>
                      </STATE-DEPENDENT-STARTUP-CONFIGS>
                    </PROCESS>
                  </ELEMENTS>
                </AR-PACKAGE>
                <AR-PACKAGE>
                  <SHORT-NAME>ServiceInstanceToPortPrototypeMappings</SHORT-NAME>
                  <ELEMENTS>
                    <SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                      <SHORT-NAME>ProvidedServiceInstance_toPort_guardian_report_fault</SHORT-NAME>
                      <PORT-PROTOTYPE-IREF>
                        <TARGET-PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/adcm/AdaptiveApplicationSwComponentTypes/Guardian/PPort_report_fault</TARGET-PORT-PROTOTYPE-REF>
                      </PORT-PROTOTYPE-IREF>
                      <PROCESS-REF DEST="PROCESS">/adcm/Machines/AdaptiveMachine/Processes/Guardian</PROCESS-REF>
                      <SERVICE-INSTANCE-REF DEST="PROVIDED-SOMEIP-SERVICE-INSTANCE">/adcm/Machines/AdaptiveMachine/ServiceInstances/ProvidedSomeipServiceInstance_report_fault</SERVICE-INSTANCE-REF>
                    </SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                    <SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                      <SHORT-NAME>RequiredServiceInstance_toPort_guardian_collect_fault_control</SHORT-NAME>
                      <PORT-PROTOTYPE-IREF>
                        <TARGET-PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/adcm/AdaptiveApplicationSwComponentTypes/Guardian/RPort_collect_fault_control</TARGET-PORT-PROTOTYPE-REF>
                      </PORT-PROTOTYPE-IREF>
                      <PROCESS-REF DEST="PROCESS">/adcm/Machines/AdaptiveMachine/Processes/Guardian</PROCESS-REF>
                      <SERVICE-INSTANCE-REF DEST="REQUIRED-SOMEIP-SERVICE-INSTANCE">/adcm/Machines/AdaptiveMachine/ServiceInstances/RequiredSomeipServiceInstance_collect_fault_control</SERVICE-INSTANCE-REF>
                    </SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                    <SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                      <SHORT-NAME>RequiredServiceInstance_toPort_guardian_collect_fault_hdmap</SHORT-NAME>
                      <PORT-PROTOTYPE-IREF>
                        <TARGET-PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/adcm/AdaptiveApplicationSwComponentTypes/Guardian/RPort_collect_fault_hdmap</TARGET-PORT-PROTOTYPE-REF>
                      </PORT-PROTOTYPE-IREF>
                      <PROCESS-REF DEST="PROCESS">/adcm/Machines/AdaptiveMachine/Processes/Guardian</PROCESS-REF>
                      <SERVICE-INSTANCE-REF DEST="REQUIRED-SOMEIP-SERVICE-INSTANCE">/adcm/Machines/AdaptiveMachine/ServiceInstances/RequiredSomeipServiceInstance_collect_fault_hdmap</SERVICE-INSTANCE-REF>
                    </SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                    <SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                      <SHORT-NAME>RequiredServiceInstance_toPort_guardian_collect_fault_hmi</SHORT-NAME>
                      <PORT-PROTOTYPE-IREF>
                        <TARGET-PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/adcm/AdaptiveApplicationSwComponentTypes/Guardian/RPort_collect_fault_hmi</TARGET-PORT-PROTOTYPE-REF>
                      </PORT-PROTOTYPE-IREF>
                      <PROCESS-REF DEST="PROCESS">/adcm/Machines/AdaptiveMachine/Processes/Guardian</PROCESS-REF>
                      <SERVICE-INSTANCE-REF DEST="REQUIRED-SOMEIP-SERVICE-INSTANCE">/adcm/Machines/AdaptiveMachine/ServiceInstances/RequiredSomeipServiceInstance_collect_fault_hmi</SERVICE-INSTANCE-REF>
                    </SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                    <SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                      <SHORT-NAME>RequiredServiceInstance_toPort_guardian_collect_fault_localization</SHORT-NAME>
                      <PORT-PROTOTYPE-IREF>
                        <TARGET-PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/adcm/AdaptiveApplicationSwComponentTypes/Guardian/RPort_collect_fault_localization</TARGET-PORT-PROTOTYPE-REF>
                      </PORT-PROTOTYPE-IREF>
                      <PROCESS-REF DEST="PROCESS">/adcm/Machines/AdaptiveMachine/Processes/Guardian</PROCESS-REF>
                      <SERVICE-INSTANCE-REF DEST="REQUIRED-SOMEIP-SERVICE-INSTANCE">/adcm/Machines/AdaptiveMachine/ServiceInstances/RequiredSomeipServiceInstance_collect_fault_localization</SERVICE-INSTANCE-REF>
                    </SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                    <SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                      <SHORT-NAME>RequiredServiceInstance_toPort_guardian_collect_fault_perception_camera</SHORT-NAME>
                      <PORT-PROTOTYPE-IREF>
                        <TARGET-PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/adcm/AdaptiveApplicationSwComponentTypes/Guardian/RPort_collect_fault_perception_camera</TARGET-PORT-PROTOTYPE-REF>
                      </PORT-PROTOTYPE-IREF>
                      <PROCESS-REF DEST="PROCESS">/adcm/Machines/AdaptiveMachine/Processes/Guardian</PROCESS-REF>
                      <SERVICE-INSTANCE-REF DEST="REQUIRED-SOMEIP-SERVICE-INSTANCE">/adcm/Machines/AdaptiveMachine/ServiceInstances/RequiredSomeipServiceInstance_collect_fault_perception_camera</SERVICE-INSTANCE-REF>
                    </SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                    <SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                      <SHORT-NAME>RequiredServiceInstance_toPort_guardian_collect_fault_perception_lidar</SHORT-NAME>
                      <PORT-PROTOTYPE-IREF>
                        <TARGET-PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/adcm/AdaptiveApplicationSwComponentTypes/Guardian/RPort_collect_fault_perception_lidar</TARGET-PORT-PROTOTYPE-REF>
                      </PORT-PROTOTYPE-IREF>
                      <PROCESS-REF DEST="PROCESS">/adcm/Machines/AdaptiveMachine/Processes/Guardian</PROCESS-REF>
                      <SERVICE-INSTANCE-REF DEST="REQUIRED-SOMEIP-SERVICE-INSTANCE">/adcm/Machines/AdaptiveMachine/ServiceInstances/RequiredSomeipServiceInstance_collect_fault_perception_lidar</SERVICE-INSTANCE-REF>
                    </SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                    <SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                      <SHORT-NAME>RequiredServiceInstance_toPort_guardian_collect_fault_planning</SHORT-NAME>
                      <PORT-PROTOTYPE-IREF>
                        <TARGET-PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/adcm/AdaptiveApplicationSwComponentTypes/Guardian/RPort_collect_fault_planning</TARGET-PORT-PROTOTYPE-REF>
                      </PORT-PROTOTYPE-IREF>
                      <PROCESS-REF DEST="PROCESS">/adcm/Machines/AdaptiveMachine/Processes/Guardian</PROCESS-REF>
                      <SERVICE-INSTANCE-REF DEST="REQUIRED-SOMEIP-SERVICE-INSTANCE">/adcm/Machines/AdaptiveMachine/ServiceInstances/RequiredSomeipServiceInstance_collect_fault_planning</SERVICE-INSTANCE-REF>
                    </SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                    <SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                      <SHORT-NAME>RequiredServiceInstance_toPort_guardian_collect_fault_routing</SHORT-NAME>
                      <PORT-PROTOTYPE-IREF>
                        <TARGET-PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/adcm/AdaptiveApplicationSwComponentTypes/Guardian/RPort_collect_fault_routing</TARGET-PORT-PROTOTYPE-REF>
                      </PORT-PROTOTYPE-IREF>
                      <PROCESS-REF DEST="PROCESS">/adcm/Machines/AdaptiveMachine/Processes/Guardian</PROCESS-REF>
                      <SERVICE-INSTANCE-REF DEST="REQUIRED-SOMEIP-SERVICE-INSTANCE">/adcm/Machines/AdaptiveMachine/ServiceInstances/RequiredSomeipServiceInstance_collect_fault_routing</SERVICE-INSTANCE-REF>
                    </SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                    <SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                      <SHORT-NAME>RequiredServiceInstance_toPort_guardian_collect_fault_v2x</SHORT-NAME>
                      <PORT-PROTOTYPE-IREF>
                        <TARGET-PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/adcm/AdaptiveApplicationSwComponentTypes/Guardian/RPort_collect_fault_v2x</TARGET-PORT-PROTOTYPE-REF>
                      </PORT-PROTOTYPE-IREF>
                      <PROCESS-REF DEST="PROCESS">/adcm/Machines/AdaptiveMachine/Processes/Guardian</PROCESS-REF>
                      <SERVICE-INSTANCE-REF DEST="REQUIRED-SOMEIP-SERVICE-INSTANCE">/adcm/Machines/AdaptiveMachine/ServiceInstances/RequiredSomeipServiceInstance_collect_fault_v2x</SERVICE-INSTANCE-REF>
                    </SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                  </ELEMENTS>
                </AR-PACKAGE>
                <AR-PACKAGE>
                  <SHORT-NAME>StartupConfigSets</SHORT-NAME>
                  <ELEMENTS>
                    <STARTUP-CONFIG>
                      <SHORT-NAME>Guardian</SHORT-NAME>
                      <ENVIRONMENT-VARIABLES>
                        <TAG-WITH-OPTIONAL-VALUE>
                          <KEY>VSOMEIP_CONFIGURATION</KEY>
                          <VALUE>/etc/vsomeip.json</VALUE>
                        </TAG-WITH-OPTIONAL-VALUE>
                      </ENVIRONMENT-VARIABLES>
                      <SCHEDULING-POLICY>SCHEDULING-POLICY-ROUND-ROBIN</SCHEDULING-POLICY>
                      <SCHEDULING-PRIORITY>12</SCHEDULING-PRIORITY>
                      <TERMINATION-BEHAVIOR>PROCESS-IS-NOT-SELF-TERMINATING</TERMINATION-BEHAVIOR>
                    </STARTUP-CONFIG>
                  </ELEMENTS>
                </AR-PACKAGE>
              </AR-PACKAGES>
            </AR-PACKAGE>
          </AR-PACKAGES>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
