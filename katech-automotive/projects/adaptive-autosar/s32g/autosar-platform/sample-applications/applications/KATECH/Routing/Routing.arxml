<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://autosar.org/schema/r4.0" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00052.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>adcm</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>AdaptiveApplicationSwComponentTypes</SHORT-NAME>
          <ELEMENTS>
            <ADAPTIVE-APPLICATION-SW-COMPONENT-TYPE>
              <SHORT-NAME>Routing</SHORT-NAME>
              <PORTS>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>PPort_collect_fault_routing</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SERVICE-INTERFACE">/adcm/collect_fault_routing</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>PPort_routing_result</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SERVICE-INTERFACE">/adcm/routing_result</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RPort_local_map</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SERVICE-INTERFACE">/adcm/local_map</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RPort_matching_info</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SERVICE-INTERFACE">/adcm/matching_info</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RPort_routing_search</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SERVICE-INTERFACE">/adcm/routing_search</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
              </PORTS>
            </ADAPTIVE-APPLICATION-SW-COMPONENT-TYPE>
          </ELEMENTS>
        </AR-PACKAGE>
        <AR-PACKAGE>
          <SHORT-NAME>Executables</SHORT-NAME>
          <ELEMENTS>
            <EXECUTABLE>
              <SHORT-NAME>Routing</SHORT-NAME>
              <CATEGORY>APPLICATION_LEVEL</CATEGORY>
              <MINIMUM-TIMER-GRANULARITY>1000</MINIMUM-TIMER-GRANULARITY>
              <ROOT-SW-COMPONENT-PROTOTYPE>
                <SHORT-NAME>Routing</SHORT-NAME>
                <APPLICATION-TYPE-TREF DEST="ADAPTIVE-APPLICATION-SW-COMPONENT-TYPE">/adcm/AdaptiveApplicationSwComponentTypes/Routing</APPLICATION-TYPE-TREF>
              </ROOT-SW-COMPONENT-PROTOTYPE>
            </EXECUTABLE>
          </ELEMENTS>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
