<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00052.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>apd</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>Executables</SHORT-NAME>
          <ELEMENTS>
            <EXECUTABLE>
              <SHORT-NAME>ara_dlt_daemon</SHORT-NAME>
            </EXECUTABLE>
            <EXECUTABLE>
              <SHORT-NAME>ara_someip_routing_daemon</SHORT-NAME>
            </EXECUTABLE>
            <EXECUTABLE>
              <SHORT-NAME>ara_vehicle_package_manager</SHORT-NAME>
            </EXECUTABLE>
            <EXECUTABLE>
              <SHORT-NAME>ara_tsync_daemon</SHORT-NAME>
              <!--<LOGGING-BEHAVIOR>USES-LOGGING</LOGGING-BEHAVIOR>-->
              <MINIMUM-TIMER-GRANULARITY>1000</MINIMUM-TIMER-GRANULARITY>
            </EXECUTABLE>
          </ELEMENTS>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
