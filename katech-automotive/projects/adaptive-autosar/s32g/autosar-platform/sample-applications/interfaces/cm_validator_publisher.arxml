<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00052.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>apd</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>CompuMethods</SHORT-NAME>
          <ELEMENTS>
            <COMPU-METHOD>
              <SHORT-NAME>VariantData</SHORT-NAME>
              <CATEGORY>TEXTTABLE</CATEGORY>
              <COMPU-INTERNAL-TO-PHYS>
                <COMPU-SCALES>
                  <COMPU-SCALE>
                    <SHORT-LABEL>China</SHORT-LABEL>
                    <SYMBOL>FV_CHINA</SYMBOL>
                    <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x01</LOWER-LIMIT>
                    <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x01</UPPER-LIMIT>
                    <COMPU-CONST>
                      <VT>FV_CHINA</VT>
                    </COMPU-CONST>
                  </COMPU-SCALE>
                  <COMPU-SCALE>
                    <SHORT-LABEL>USA</SHORT-LABEL>
                    <SYMBOL>FV_USA</SYMBOL>
                    <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x05</LOWER-LIMIT>
                    <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x05</UPPER-LIMIT>
                    <COMPU-CONST>
                      <VT>FV_USA</VT>
                    </COMPU-CONST>
                  </COMPU-SCALE>
                  <COMPU-SCALE>
                    <SHORT-LABEL>Europe</SHORT-LABEL>
                    <SYMBOL>FV_EUROPE</SYMBOL>
                    <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x06</LOWER-LIMIT>
                    <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x06</UPPER-LIMIT>
                    <COMPU-CONST>
                      <VT>FV_EUROPE</VT>
                    </COMPU-CONST>
                  </COMPU-SCALE>
                  <COMPU-SCALE>
                    <SHORT-LABEL>Russia</SHORT-LABEL>
                    <SYMBOL>FV_RUSSIA</SYMBOL>
                    <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x07</LOWER-LIMIT>
                    <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x07</UPPER-LIMIT>
                    <COMPU-CONST>
                      <VT>FV_RUSSIA</VT>
                    </COMPU-CONST>
                  </COMPU-SCALE>
                </COMPU-SCALES>
              </COMPU-INTERNAL-TO-PHYS>
            </COMPU-METHOD>
          </ELEMENTS>
        </AR-PACKAGE>
        <AR-PACKAGE>
          <SHORT-NAME>CppImplementationDataTypes</SHORT-NAME>
          <ELEMENTS>
            <STD-CPP-IMPLEMENTATION-DATA-TYPE>
              <SHORT-NAME>PublisherObjects</SHORT-NAME>
              <CATEGORY>STRUCTURE</CATEGORY>
              <NAMESPACES>
                <SYMBOL-PROPS>
                  <SHORT-NAME>ara</SHORT-NAME>
                  <SYMBOL>ara</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>com</SHORT-NAME>
                  <SYMBOL>com</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>sample</SHORT-NAME>
                  <SYMBOL>sample</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <SUB-ELEMENTS>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>active</SHORT-NAME>
                  <TYPE-REFERENCE>
                    <INPLACE>false</INPLACE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/bool</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>objectVector</SHORT-NAME>
                  <TYPE-REFERENCE>
                    <INPLACE>false</INPLACE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/apd/CppImplementationDataTypes/ByteArray</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
              </SUB-ELEMENTS>
              <TYPE-EMITTER>TYPE_EMITTER_ARA</TYPE-EMITTER>
            </STD-CPP-IMPLEMENTATION-DATA-TYPE>
            <STD-CPP-IMPLEMENTATION-DATA-TYPE>
              <SHORT-NAME>PositionData</SHORT-NAME>
              <CATEGORY>STRUCTURE</CATEGORY>
              <NAMESPACES>
                <SYMBOL-PROPS>
                  <SHORT-NAME>ara</SHORT-NAME>
                  <SYMBOL>ara</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>com</SHORT-NAME>
                  <SYMBOL>com</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>sample</SHORT-NAME>
                  <SYMBOL>sample</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <SUB-ELEMENTS>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>x</SHORT-NAME>
                  <TYPE-REFERENCE>
                    <INPLACE>false</INPLACE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/int32_t</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>y</SHORT-NAME>
                  <TYPE-REFERENCE>
                    <INPLACE>false</INPLACE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/int32_t</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>z</SHORT-NAME>
                  <TYPE-REFERENCE>
                    <INPLACE>false</INPLACE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/int32_t</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
              </SUB-ELEMENTS>
              <TYPE-EMITTER>TYPE_EMITTER_ARA</TYPE-EMITTER>
            </STD-CPP-IMPLEMENTATION-DATA-TYPE>
            <STD-CPP-IMPLEMENTATION-DATA-TYPE>
              <SHORT-NAME>VariantData</SHORT-NAME>
              <CATEGORY>TYPE_REFERENCE</CATEGORY>
              <SW-DATA-DEF-PROPS>
                <SW-DATA-DEF-PROPS-VARIANTS>
                  <SW-DATA-DEF-PROPS-CONDITIONAL>
                    <COMPU-METHOD-REF DEST="COMPU-METHOD">/apd/CompuMethods/VariantData</COMPU-METHOD-REF>
                  </SW-DATA-DEF-PROPS-CONDITIONAL>
                </SW-DATA-DEF-PROPS-VARIANTS>
              </SW-DATA-DEF-PROPS>
              <NAMESPACES>
                <SYMBOL-PROPS>
                  <SHORT-NAME>ara</SHORT-NAME>
                  <SYMBOL>ara</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>com</SHORT-NAME>
                  <SYMBOL>com</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>sample</SHORT-NAME>
                  <SYMBOL>sample</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <TYPE-EMITTER>TYPE_EMITTER_ARA</TYPE-EMITTER>
              <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint16_t</TYPE-REFERENCE-REF>
            </STD-CPP-IMPLEMENTATION-DATA-TYPE>
          </ELEMENTS>
        </AR-PACKAGE>
        <AR-PACKAGE>
          <SHORT-NAME>PubSubErrors</SHORT-NAME>
          <ELEMENTS>
            <AP-APPLICATION-ERROR-DOMAIN>
              <SHORT-NAME>SpecificErrors</SHORT-NAME>
              <NAMESPACES>
                <SYMBOL-PROPS>
                  <SHORT-NAME>ara</SHORT-NAME>
                  <SYMBOL>ara</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>com</SHORT-NAME>
                  <SYMBOL>com</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>sample</SHORT-NAME>
                  <SYMBOL>sample</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <VALUE>44</VALUE>
            </AP-APPLICATION-ERROR-DOMAIN>
            <AP-APPLICATION-ERROR-DOMAIN>
              <SHORT-NAME>GenericErrors</SHORT-NAME>
              <NAMESPACES>
                <SYMBOL-PROPS>
                  <SHORT-NAME>ara</SHORT-NAME>
                  <SYMBOL>ara</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>com</SHORT-NAME>
                  <SYMBOL>com</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>sample</SHORT-NAME>
                  <SYMBOL>sample</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <VALUE>45</VALUE>
            </AP-APPLICATION-ERROR-DOMAIN>
            <AP-APPLICATION-ERROR>
              <SHORT-NAME>InvalidConfigString</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Configuration string is invalid.</L-2>
              </DESC>
              <ERROR-CODE>5</ERROR-CODE>
              <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/apd/PubSubErrors/SpecificErrors</ERROR-DOMAIN-REF>
            </AP-APPLICATION-ERROR>
            <AP-APPLICATION-ERROR>
              <SHORT-NAME>InvalidParameter</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Parameter is invalid.</L-2>
              </DESC>
              <ERROR-CODE>6</ERROR-CODE>
              <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/apd/PubSubErrors/SpecificErrors</ERROR-DOMAIN-REF>
            </AP-APPLICATION-ERROR>
            <AP-APPLICATION-ERROR>
              <SHORT-NAME>GenericFailure1</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Generic failure.</L-2>
              </DESC>
              <ERROR-CODE>12</ERROR-CODE>
              <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/apd/PubSubErrors/GenericErrors</ERROR-DOMAIN-REF>
            </AP-APPLICATION-ERROR>
          </ELEMENTS>
        </AR-PACKAGE>
        <AR-PACKAGE>
          <SHORT-NAME>ServiceInterfaces</SHORT-NAME>
          <ELEMENTS>
            <SERVICE-INTERFACE>
              <SHORT-NAME>CMValidatorPublisher</SHORT-NAME>
              <NAMESPACES>
                <SYMBOL-PROPS>
                  <SHORT-NAME>ara</SHORT-NAME>
                  <SYMBOL>ara</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>com</SHORT-NAME>
                  <SYMBOL>com</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>sample</SHORT-NAME>
                  <SYMBOL>sample</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <EVENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>Event1</SHORT-NAME>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/apd/CppImplementationDataTypes/PublisherObjects</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>Event2</SHORT-NAME>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/apd/CppImplementationDataTypes/PublisherObjects</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </EVENTS>
              <FIELDS>
                <FIELD>
                  <SHORT-NAME>Field1</SHORT-NAME>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint32_t</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>true</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>Field2</SHORT-NAME>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint16_t</TYPE-TREF>
                  <HAS-GETTER>false</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
              </FIELDS>
              <METHODS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>MethodsCapability</SHORT-NAME>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>result</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/bool</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                  <POSSIBLE-AP-ERROR-REFS>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/apd/PubSubErrors/InvalidConfigString</POSSIBLE-AP-ERROR-REF>
                  </POSSIBLE-AP-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>Echo</SHORT-NAME>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>text</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/apd/CppImplementationDataTypes/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                  <FIRE-AND-FORGET>true</FIRE-AND-FORGET>
                </CLIENT-SERVER-OPERATION>
              </METHODS>
            </SERVICE-INTERFACE>
          </ELEMENTS>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
