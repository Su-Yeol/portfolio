<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00052.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>apd</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>ServiceInterfaceDeployments</SHORT-NAME>
          <ELEMENTS>
            <SOMEIP-SERVICE-INTERFACE-DEPLOYMENT>
              <SHORT-NAME>Radar_Someip</SHORT-NAME>
              <EVENT-DEPLOYMENTS>
                <SOMEIP-EVENT-DEPLOYMENT>
                  <SHORT-NAME>Brake_Someip</SHORT-NAME>
                  <EVENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/apd/ServiceInterfaces/radar/brakeEvent</EVENT-REF>
                  <EVENT-ID>1</EVENT-ID>
                  <TRANSPORT-PROTOCOL>UDP</TRANSPORT-PROTOCOL>
                </SOMEIP-EVENT-DEPLOYMENT>
                <SOMEIP-EVENT-DEPLOYMENT>
                  <SHORT-NAME>ParkingBrake_Someip</SHORT-NAME>
                  <EVENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/apd/ServiceInterfaces/radar/parkingBrakeEvent</EVENT-REF>
                  <EVENT-ID>2</EVENT-ID>
                  <TRANSPORT-PROTOCOL>UDP</TRANSPORT-PROTOCOL>
                </SOMEIP-EVENT-DEPLOYMENT>
              </EVENT-DEPLOYMENTS>
              <FIELD-DEPLOYMENTS>
                <SOMEIP-FIELD-DEPLOYMENT>
                  <SHORT-NAME>UpdateRate_Someip</SHORT-NAME>
                  <FIELD-REF DEST="FIELD">/apd/ServiceInterfaces/radar/UpdateRate</FIELD-REF>
                  <GET>
                    <SHORT-NAME>getter</SHORT-NAME>
                    <METHOD-ID>3001</METHOD-ID>
                    <TRANSPORT-PROTOCOL>UDP</TRANSPORT-PROTOCOL>
                  </GET>
                  <NOTIFIER>
                    <SHORT-NAME>notifier</SHORT-NAME>
                    <EVENT-ID>3000</EVENT-ID>
                    <TRANSPORT-PROTOCOL>UDP</TRANSPORT-PROTOCOL>
                  </NOTIFIER>
                  <SET>
                    <SHORT-NAME>setter</SHORT-NAME>
                    <METHOD-ID>3002</METHOD-ID>
                    <TRANSPORT-PROTOCOL>UDP</TRANSPORT-PROTOCOL>
                  </SET>
                </SOMEIP-FIELD-DEPLOYMENT>
                <SOMEIP-FIELD-DEPLOYMENT>
                  <SHORT-NAME>FrontObjectDistance_Someip</SHORT-NAME>
                  <FIELD-REF DEST="FIELD">/apd/ServiceInterfaces/radar/FrontObjectDistance</FIELD-REF>
                  <NOTIFIER>
                    <SHORT-NAME>notifier</SHORT-NAME>
                    <EVENT-ID>3004</EVENT-ID>
                    <TRANSPORT-PROTOCOL>UDP</TRANSPORT-PROTOCOL>
                  </NOTIFIER>
                </SOMEIP-FIELD-DEPLOYMENT>
                <SOMEIP-FIELD-DEPLOYMENT>
                  <SHORT-NAME>RearObjectDistance_Someip</SHORT-NAME>
                  <FIELD-REF DEST="FIELD">/apd/ServiceInterfaces/radar/RearObjectDistance</FIELD-REF>
                  <GET>
                    <SHORT-NAME>getter</SHORT-NAME>
                    <METHOD-ID>3006</METHOD-ID>
                    <TRANSPORT-PROTOCOL>UDP</TRANSPORT-PROTOCOL>
                  </GET>
                </SOMEIP-FIELD-DEPLOYMENT>
                <SOMEIP-FIELD-DEPLOYMENT>
                  <SHORT-NAME>ObjectDetectionLimit_Someip</SHORT-NAME>
                  <FIELD-REF DEST="FIELD">/apd/ServiceInterfaces/radar/ObjectDetectionLimit</FIELD-REF>
                  <SET>
                    <SHORT-NAME>setter</SHORT-NAME>
                    <METHOD-ID>3011</METHOD-ID>
                    <TRANSPORT-PROTOCOL>UDP</TRANSPORT-PROTOCOL>
                  </SET>
                </SOMEIP-FIELD-DEPLOYMENT>
              </FIELD-DEPLOYMENTS>
              <METHOD-DEPLOYMENTS>
                <SOMEIP-METHOD-DEPLOYMENT>
                  <SHORT-NAME>Adjust_Someip</SHORT-NAME>
                  <METHOD-REF DEST="CLIENT-SERVER-OPERATION">/apd/ServiceInterfaces/radar/Adjust</METHOD-REF>
                  <METHOD-ID>32000</METHOD-ID>
                  <TRANSPORT-PROTOCOL>UDP</TRANSPORT-PROTOCOL>
                </SOMEIP-METHOD-DEPLOYMENT>
                <SOMEIP-METHOD-DEPLOYMENT>
                  <SHORT-NAME>Calibrate_Someip</SHORT-NAME>
                  <METHOD-REF DEST="CLIENT-SERVER-OPERATION">/apd/ServiceInterfaces/radar/Calibrate</METHOD-REF>
                  <METHOD-ID>32010</METHOD-ID>
                  <TRANSPORT-PROTOCOL>UDP</TRANSPORT-PROTOCOL>
                </SOMEIP-METHOD-DEPLOYMENT>
                <SOMEIP-METHOD-DEPLOYMENT>
                  <SHORT-NAME>EchoSomeipMethod</SHORT-NAME>
                  <METHOD-REF DEST="CLIENT-SERVER-OPERATION">/apd/ServiceInterfaces/radar/Echo</METHOD-REF>
                  <METHOD-ID>32020</METHOD-ID>
                  <TRANSPORT-PROTOCOL>UDP</TRANSPORT-PROTOCOL>
                </SOMEIP-METHOD-DEPLOYMENT>
              </METHOD-DEPLOYMENTS>
              <SERVICE-INTERFACE-REF DEST="SERVICE-INTERFACE">/apd/ServiceInterfaces/radar</SERVICE-INTERFACE-REF>
              <EVENT-GROUPS>
                <SOMEIP-EVENT-GROUP>
                  <SHORT-NAME>SomeipEventgroup1</SHORT-NAME>
                  <EVENT-GROUP-ID>1</EVENT-GROUP-ID>
                  <EVENT-REFS>
                    <EVENT-REF DEST="SOMEIP-EVENT-DEPLOYMENT">/apd/ServiceInterfaceDeployments/Radar_Someip/Brake_Someip</EVENT-REF>
