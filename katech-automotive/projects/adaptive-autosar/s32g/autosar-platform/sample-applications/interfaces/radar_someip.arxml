                </SOMEIP-EVENT-GROUP>
                <SOMEIP-EVENT-GROUP>
                  <SHORT-NAME>SomeipEventgroup2</SHORT-NAME>
                  <EVENT-GROUP-ID>2</EVENT-GROUP-ID>
                  <EVENT-REFS>
                    <EVENT-REF DEST="SOMEIP-EVENT-DEPLOYMENT">/apd/ServiceInterfaceDeployments/Radar_Someip/ParkingBrake_Someip</EVENT-REF>
                  </EVENT-REFS>
                </SOMEIP-EVENT-GROUP>
                <SOMEIP-EVENT-GROUP>
                  <SHORT-NAME>SomeipEventgroup3</SHORT-NAME>
                  <EVENT-GROUP-ID>3</EVENT-GROUP-ID>
                  <EVENT-REFS>
                    <EVENT-REF DEST="SOMEIP-EVENT-DEPLOYMENT">/apd/ServiceInterfaceDeployments/Radar_Someip/UpdateRate_Someip/notifier</EVENT-REF>
                  </EVENT-REFS>
                </SOMEIP-EVENT-GROUP>
                <SOMEIP-EVENT-GROUP>
                  <SHORT-NAME>SomeipEventgroup4</SHORT-NAME>
                  <EVENT-GROUP-ID>4</EVENT-GROUP-ID>
                  <EVENT-REFS>
                    <EVENT-REF DEST="SOMEIP-EVENT-DEPLOYMENT">/apd/ServiceInterfaceDeployments/Radar_Someip/FrontObjectDistance_Someip/notifier</EVENT-REF>
                  </EVENT-REFS>
                </SOMEIP-EVENT-GROUP>
              </EVENT-GROUPS>
              <SERVICE-INTERFACE-ID>99</SERVICE-INTERFACE-ID>
              <SERVICE-INTERFACE-VERSION>
                <MAJOR-VERSION>1</MAJOR-VERSION>
                <MINOR-VERSION>0</MINOR-VERSION>
              </SERVICE-INTERFACE-VERSION>
            </SOMEIP-SERVICE-INTERFACE-DEPLOYMENT>
          </ELEMENTS>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
