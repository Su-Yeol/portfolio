                  <SYMBOL>apd</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>testsuite</SHORT-NAME>
                  <SYMBOL>testsuite</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>cmdds</SHORT-NAME>
                  <SYMBOL>cmdds</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <EVENTS>
