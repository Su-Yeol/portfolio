<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00052.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>adcmErrors</SHORT-NAME>
      <ELEMENTS>
        <AP-APPLICATION-ERROR>
          <SHORT-NAME>InvalidConfigString</SHORT-NAME>
          <DESC>
            <L-2 L="EN">Configuration string is invalid.</L-2>
          </DESC>
          <ERROR-CODE>5</ERROR-CODE>
          <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/adcmErrors/SpecificErrors</ERROR-DOMAIN-REF>
        </AP-APPLICATION-ERROR>
        <AP-APPLICATION-ERROR>
          <SHORT-NAME>InvalidParameter</SHORT-NAME>
          <DESC>
            <L-2 L="EN">Parameter is invalid.</L-2>
          </DESC>
          <ERROR-CODE>6</ERROR-CODE>
          <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/adcmErrors/SpecificErrors</ERROR-DOMAIN-REF>
        </AP-APPLICATION-ERROR>
        <AP-APPLICATION-ERROR>
          <SHORT-NAME>GenericFailure</SHORT-NAME>
          <DESC>
            <L-2 L="EN">Generic failure.</L-2>
          </DESC>
          <ERROR-CODE>12</ERROR-CODE>
          <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/adcmErrors/GenericErrors</ERROR-DOMAIN-REF>
        </AP-APPLICATION-ERROR>
        <AP-APPLICATION-ERROR-DOMAIN>
          <SHORT-NAME>SpecificErrors</SHORT-NAME>
          <NAMESPACES>
            <SYMBOL-PROPS>
              <SHORT-NAME>adcm</SHORT-NAME>
              <SYMBOL>adcm</SYMBOL>
            </SYMBOL-PROPS>
          </NAMESPACES>
          <VALUE>44</VALUE>
        </AP-APPLICATION-ERROR-DOMAIN>
        <AP-APPLICATION-ERROR-DOMAIN>
          <SHORT-NAME>GenericErrors</SHORT-NAME>
          <NAMESPACES>
            <SYMBOL-PROPS>
              <SHORT-NAME>adcm</SHORT-NAME>
              <SYMBOL>adcm</SYMBOL>
            </SYMBOL-PROPS>
          </NAMESPACES>
          <VALUE>45</VALUE>
        </AP-APPLICATION-ERROR-DOMAIN>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
