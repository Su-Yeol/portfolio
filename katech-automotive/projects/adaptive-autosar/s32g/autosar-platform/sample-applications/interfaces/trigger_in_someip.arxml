<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00052.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>apd</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>ServiceInterfaceDeployments</SHORT-NAME>
          <ELEMENTS>
            <SOMEIP-SERVICE-INTERFACE-DEPLOYMENT>
              <SHORT-NAME>TriggerIn_Someip</SHORT-NAME>
              <FIELD-DEPLOYMENTS>
                <SOMEIP-FIELD-DEPLOYMENT>
                  <SHORT-NAME>Trigger_Someip</SHORT-NAME>
                  <FIELD-REF DEST="FIELD">/apd/ServiceInterfaces/TriggerIn/Trigger</FIELD-REF>
                  <SET>
                    <SHORT-NAME>Set</SHORT-NAME>
                    <METHOD-ID>1</METHOD-ID>
                    <TRANSPORT-PROTOCOL>UDP</TRANSPORT-PROTOCOL>
                  </SET>
                </SOMEIP-FIELD-DEPLOYMENT>
              </FIELD-DEPLOYMENTS>
              <SERVICE-INTERFACE-REF DEST="SERVICE-INTERFACE">/apd/ServiceInterfaces/TriggerIn</SERVICE-INTERFACE-REF>
              <SERVICE-INTERFACE-ID>667</SERVICE-INTERFACE-ID>
              <SERVICE-INTERFACE-VERSION>
                <MAJOR-VERSION>1</MAJOR-VERSION>
                <MINOR-VERSION>0</MINOR-VERSION>
              </SERVICE-INTERFACE-VERSION>
            </SOMEIP-SERVICE-INTERFACE-DEPLOYMENT>
          </ELEMENTS>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
