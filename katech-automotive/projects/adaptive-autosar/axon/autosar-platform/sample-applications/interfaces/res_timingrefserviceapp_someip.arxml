<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00052.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>apd</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>ServiceInterfaceDeployments</SHORT-NAME>
          <ELEMENTS>
            <SOMEIP-SERVICE-INTERFACE-DEPLOYMENT>
              <SHORT-NAME>SensorActuatorService_Someip</SHORT-NAME>
              <EVENT-DEPLOYMENTS>
                <SOMEIP-EVENT-DEPLOYMENT>
                  <SHORT-NAME>sensorData_Someip</SHORT-NAME>
                  <EVENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/apd/ServiceInterfaces/SensorActuatorService/sensorData</EVENT-REF>
                  <EVENT-ID>55</EVENT-ID>
                  <TRANSPORT-PROTOCOL>UDP</TRANSPORT-PROTOCOL>
                </SOMEIP-EVENT-DEPLOYMENT>
              </EVENT-DEPLOYMENTS>
              <METHOD-DEPLOYMENTS>
                <SOMEIP-METHOD-DEPLOYMENT>
                  <SHORT-NAME>action_Someip</SHORT-NAME>
                  <METHOD-REF DEST="CLIENT-SERVER-OPERATION">/apd/ServiceInterfaces/SensorActuatorService/Action</METHOD-REF>
                  <METHOD-ID>13</METHOD-ID>
                  <TRANSPORT-PROTOCOL>UDP</TRANSPORT-PROTOCOL>
                </SOMEIP-METHOD-DEPLOYMENT>
              </METHOD-DEPLOYMENTS>
              <SERVICE-INTERFACE-REF DEST="SERVICE-INTERFACE">/apd/ServiceInterfaces/SensorActuatorService</SERVICE-INTERFACE-REF>
              <EVENT-GROUPS>
                <SOMEIP-EVENT-GROUP>
                  <SHORT-NAME>sensorData_Someip_group</SHORT-NAME>
                  <EVENT-GROUP-ID>1</EVENT-GROUP-ID>
                  <EVENT-REFS>
                    <EVENT-REF DEST="SOMEIP-EVENT-DEPLOYMENT">/apd/ServiceInterfaceDeployments/SensorActuatorService_Someip/sensorData_Someip</EVENT-REF>
                  </EVENT-REFS>
                </SOMEIP-EVENT-GROUP>
              </EVENT-GROUPS>
              <SERVICE-INTERFACE-ID>23</SERVICE-INTERFACE-ID>
              <SERVICE-INTERFACE-VERSION>
                <MAJOR-VERSION>1</MAJOR-VERSION>
                <MINOR-VERSION>0</MINOR-VERSION>
              </SERVICE-INTERFACE-VERSION>
            </SOMEIP-SERVICE-INTERFACE-DEPLOYMENT>
          </ELEMENTS>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
