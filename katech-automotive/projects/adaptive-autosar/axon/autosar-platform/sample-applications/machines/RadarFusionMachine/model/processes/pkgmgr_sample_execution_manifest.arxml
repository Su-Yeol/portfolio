<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00052.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>apd</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>Machines</SHORT-NAME>
          <AR-PACKAGES>
            <AR-PACKAGE>
              <SHORT-NAME>RadarFusionMachine</SHORT-NAME>
              <AR-PACKAGES>
                <AR-PACKAGE>
                  <SHORT-NAME>ProcessToMachineMappings</SHORT-NAME>
                  <ELEMENTS>
                    <PROCESS-TO-MACHINE-MAPPING-SET>
                      <SHORT-NAME>pkgmgr_sample</SHORT-NAME>
                      <PROCESS-TO-MACHINE-MAPPINGS>
                        <PROCESS-TO-MACHINE-MAPPING>
                          <SHORT-NAME>pkgmgr_sample</SHORT-NAME>
                          <MACHINE-REF DEST="MACHINE">/apd/Machines/RadarFusionMachine/RadarFusionMachine</MACHINE-REF>
                          <PROCESS-REF DEST="PROCESS">/apd/Machines/RadarFusionMachine/Processes/pkgmgr_sample</PROCESS-REF>
                        </PROCESS-TO-MACHINE-MAPPING>
                      </PROCESS-TO-MACHINE-MAPPINGS>
                    </PROCESS-TO-MACHINE-MAPPING-SET>
                  </ELEMENTS>
                </AR-PACKAGE>
                <AR-PACKAGE>
                  <SHORT-NAME>DltLogChannelToProcessMappings</SHORT-NAME>
                  <ELEMENTS>
                    <DLT-APPLICATION-TO-PROCESS-MAPPING>
                      <SHORT-NAME>pkgmgr_sampleDltApplicationToProcessMapping</SHORT-NAME>
                      <DLT-APPLICATION-REF DEST="DLT-APPLICATION">/apd/Machines/RadarFusionMachine/Dlt/RadarFusionDltEcu/PkgmgrApplication</DLT-APPLICATION-REF>
                      <PROCESS-REF DEST="PROCESS">/apd/Machines/RadarFusionMachine/Processes/pkgmgr_sample</PROCESS-REF>
                    </DLT-APPLICATION-TO-PROCESS-MAPPING>
                    <DLT-LOG-SINK-TO-PORT-PROTOTYPE-MAPPING>
                      <SHORT-NAME>pkgmgr_sampleDltLogSinkToPortPrototypeMapping</SHORT-NAME>
                      <DLT-CONTEXT-REF DEST="DLT-CONTEXT">/apd/Dlt/DefaultDltContext</DLT-CONTEXT-REF>
                      <DLT-LOG-SINK-REFS>
                        <DLT-LOG-SINK-REF DEST="DLT-LOG-SINK">/apd/Machines/RadarFusionMachine/Dlt/ConsoleDltSink</DLT-LOG-SINK-REF>
                        <DLT-LOG-SINK-REF DEST="DLT-LOG-SINK">/apd/Dlt/RemoteDltSink</DLT-LOG-SINK-REF>
                        <DLT-LOG-SINK-REF DEST="DLT-LOG-SINK">/apd/Dlt/PkgmgrFileDltSink</DLT-LOG-SINK-REF>
                      </DLT-LOG-SINK-REFS>
                      <PROCESS-REF DEST="PROCESS">/apd/Machines/RadarFusionMachine/Processes/pkgmgr_sample</PROCESS-REF>
                    </DLT-LOG-SINK-TO-PORT-PROTOTYPE-MAPPING>
                  </ELEMENTS>
                </AR-PACKAGE>
                <AR-PACKAGE>
                  <SHORT-NAME>Processes</SHORT-NAME>
                  <ELEMENTS>
                    <PROCESS>
                      <SHORT-NAME>pkgmgr_sample</SHORT-NAME>
                      <EXECUTABLE-REFS>
                        <EXECUTABLE-REF DEST="EXECUTABLE">/apd/Executables/pkgmgr_sample</EXECUTABLE-REF>
                      </EXECUTABLE-REFS>
                      <PROCESS-STATE-MACHINE>
                        <SHORT-NAME>state_machine</SHORT-NAME>
                        <TYPE-TREF DEST="MODE-DECLARATION-GROUP">/apd/ModeDeclarationGroups/ProcessStateMachine</TYPE-TREF>
                      </PROCESS-STATE-MACHINE>
                      <STATE-DEPENDENT-STARTUP-CONFIGS>
                        <STATE-DEPENDENT-STARTUP-CONFIG>
                          <FUNCTION-GROUP-STATE-IREFS>
                            <FUNCTION-GROUP-STATE-IREF>
                              <CONTEXT-MODE-DECLARATION-GROUP-PROTOTYPE-REF DEST="MODE-DECLARATION-GROUP-PROTOTYPE">/apd/Machines/RadarFusionMachine/FunctionGroupSets/RadarFusionFunctionGroups/UCMDemoModeFG</CONTEXT-MODE-DECLARATION-GROUP-PROTOTYPE-REF>
                              <TARGET-MODE-DECLARATION-REF DEST="MODE-DECLARATION">/apd/ModeDeclarationGroups/UCMDemoModeFG/UCM_ITM</TARGET-MODE-DECLARATION-REF>
                            </FUNCTION-GROUP-STATE-IREF>
                          </FUNCTION-GROUP-STATE-IREFS>
                          <RESOURCE-GROUP-REF DEST="RESOURCE-GROUP">/apd/Machines/RadarFusionMachine/RadarFusionMachine/Linux/ResourceGroup1</RESOURCE-GROUP-REF>
                          <STARTUP-CONFIG-REF DEST="STARTUP-CONFIG">/apd/Machines/RadarFusionMachine/StartupConfigSets/pkgmgr_sample_startup</STARTUP-CONFIG-REF>
                        </STATE-DEPENDENT-STARTUP-CONFIG>
                      </STATE-DEPENDENT-STARTUP-CONFIGS>
                    </PROCESS>
                  </ELEMENTS>
                </AR-PACKAGE>
                <AR-PACKAGE>
                  <SHORT-NAME>ServiceInstanceToPortPrototypeMappings</SHORT-NAME>
                  <ELEMENTS>
                    <SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                      <SHORT-NAME>RequiredPackageManagementInstanceToPortMapping</SHORT-NAME>
                      <PORT-PROTOTYPE-IREF>
                        <TARGET-PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/apd/AdaptiveApplicationSwComponentTypes/pkgmgr_sample/PackageManagementRPort</TARGET-PORT-PROTOTYPE-REF>
                      </PORT-PROTOTYPE-IREF>
                      <PROCESS-REF DEST="PROCESS">/apd/Machines/RadarFusionMachine/Processes/pkgmgr_sample</PROCESS-REF>
                      <SERVICE-INSTANCE-REF DEST="REQUIRED-SOMEIP-SERVICE-INSTANCE">/apd/Machines/RadarFusionMachine/ServiceInstances/RequiredSomeIpPackageManagementInstance</SERVICE-INSTANCE-REF>
                    </SERVICE-INSTANCE-TO-PORT-PROTOTYPE-MAPPING>
                  </ELEMENTS>
                </AR-PACKAGE>
                <AR-PACKAGE>
                  <SHORT-NAME>StartupConfigSets</SHORT-NAME>
                  <ELEMENTS>
                    <STARTUP-CONFIG>
                      <SHORT-NAME>pkgmgr_sample_startup</SHORT-NAME>
                      <PROCESS-ARGUMENTS>
                        <PROCESS-ARGUMENT>
                          <ARGUMENT>--campaign</ARGUMENT>
                        </PROCESS-ARGUMENT>
                        <PROCESS-ARGUMENT>
                          <ARGUMENT>UpdatableAppSwpkgInstall_1.0.0.zip</ARGUMENT>
                        </PROCESS-ARGUMENT>
                        <PROCESS-ARGUMENT>
                          <ARGUMENT>--campaign</ARGUMENT>
                        </PROCESS-ARGUMENT>
                        <PROCESS-ARGUMENT>
                          <ARGUMENT>UpdatableAppSwpkgUpdate_2.0.0.zip</ARGUMENT>
                        </PROCESS-ARGUMENT>
                        <PROCESS-ARGUMENT>
                          <ARGUMENT>--campaign</ARGUMENT>
                        </PROCESS-ARGUMENT>
                        <PROCESS-ARGUMENT>
                          <ARGUMENT>UpdatableAppSwpkgRemove_3.0.0.zip</ARGUMENT>
                        </PROCESS-ARGUMENT>
                        <PROCESS-ARGUMENT>
                          <ARGUMENT>--test-downgrade</ARGUMENT>
                        </PROCESS-ARGUMENT>
                        <PROCESS-ARGUMENT>
                          <ARGUMENT>UpdatableAppSwpkgInstall_1.0.0.zip</ARGUMENT>
                        </PROCESS-ARGUMENT>
                        <PROCESS-ARGUMENT>
                          <ARGUMENT>--ucmId</ARGUMENT>
                        </PROCESS-ARGUMENT>
                        <PROCESS-ARGUMENT>
                          <ARGUMENT>RadarFusionMachineUCM</ARGUMENT>
                        </PROCESS-ARGUMENT>
                      </PROCESS-ARGUMENTS>
                      <SCHEDULING-POLICY>SCHEDULING-POLICY-ROUND-ROBIN</SCHEDULING-POLICY>
                      <SCHEDULING-PRIORITY>12</SCHEDULING-PRIORITY>
                      <TERMINATION-BEHAVIOR>PROCESS-IS-SELF-TERMINATING</TERMINATION-BEHAVIOR>
                    </STARTUP-CONFIG>
                  </ELEMENTS>
                </AR-PACKAGE>
              </AR-PACKAGES>
            </AR-PACKAGE>
          </AR-PACKAGES>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
