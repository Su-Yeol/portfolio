<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00052.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>apd</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>Machines</SHORT-NAME>
          <AR-PACKAGES>
            <AR-PACKAGE>
              <SHORT-NAME>RadarFusionMachine</SHORT-NAME>
              <AR-PACKAGES>
                <AR-PACKAGE>
                  <SHORT-NAME>ServiceInstanceToMachineMappings</SHORT-NAME>
                  <ELEMENTS>
                    <SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                      <SHORT-NAME>radar_ProvidedServiceInstance_toMachine</SHORT-NAME>
                      <COMMUNICATION-CONNECTOR-REF DEST="ETHERNET-COMMUNICATION-CONNECTOR">/apd/MachineDesigns/RadarFusionMachineDesign/RadarFusionConnector</COMMUNICATION-CONNECTOR-REF>
                      <SERVICE-INSTANCE-REFS>
                        <SERVICE-INSTANCE-REF DEST="PROVIDED-SOMEIP-SERVICE-INSTANCE">/apd/Machines/RadarFusionMachine/ServiceInstances/RadarProvidedSomeipServiceInstance</SERVICE-INSTANCE-REF>
                      </SERVICE-INSTANCE-REFS>
                      <UDP-PORT-REF DEST="AP-APPLICATION-ENDPOINT">/apd/MachineDesigns/RadarFusionMachineDesign/RadarFusionConnector/TriggerApplicationEndpoint</UDP-PORT-REF>
                    </SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                  </ELEMENTS>
                </AR-PACKAGE>
                <AR-PACKAGE>
                  <SHORT-NAME>ServiceInstances</SHORT-NAME>
                  <ELEMENTS>
                    <PROVIDED-SOMEIP-SERVICE-INSTANCE>
                      <SHORT-NAME>RadarProvidedSomeipServiceInstance</SHORT-NAME>
                      <E-2-E-EVENT-PROTECTION-PROPSS>
                        <END-2-END-EVENT-PROTECTION-PROPS>
                          <SHORT-NAME>End2EndEventProtectionProps</SHORT-NAME>
                          <DATA-IDS>
                            <DATA-ID>4321</DATA-ID>
                          </DATA-IDS>
                          <E-2-E-PROFILE-CONFIGURATION-REF DEST="E-2-E-PROFILE-CONFIGURATION">/apd/Machines/RadarFusionMachine/E2E/e2eprofiles/PROFILE_01</E-2-E-PROFILE-CONFIGURATION-REF>
                          <EVENT-REF DEST="SOMEIP-EVENT-DEPLOYMENT">/apd/ServiceInterfaceDeployments/Radar_Someip/Brake_Someip</EVENT-REF>
                          <MAX-DATA-LENGTH>4096</MAX-DATA-LENGTH>
                          <MIN-DATA-LENGTH>1</MIN-DATA-LENGTH>
                        </END-2-END-EVENT-PROTECTION-PROPS>
                        <END-2-END-EVENT-PROTECTION-PROPS>
                          <SHORT-NAME>End2EndEventProtectionProps</SHORT-NAME>
                          <DATA-IDS>
                            <DATA-ID>4321</DATA-ID>
                            <DATA-ID>4321</DATA-ID>
                          </DATA-IDS>
                          <E-2-E-PROFILE-CONFIGURATION-REF DEST="E-2-E-PROFILE-CONFIGURATION">/apd/Machines/RadarFusionMachine/E2E/e2eprofiles/PROFILE_01</E-2-E-PROFILE-CONFIGURATION-REF>
                          <EVENT-REF DEST="SOMEIP-EVENT-DEPLOYMENT">/apd/ServiceInterfaceDeployments/Radar_Someip/ParkingBrake_Someip</EVENT-REF>
                          <MAX-DATA-LENGTH>4096</MAX-DATA-LENGTH>
                          <MIN-DATA-LENGTH>1</MIN-DATA-LENGTH>
                        </END-2-END-EVENT-PROTECTION-PROPS>
                      </E-2-E-EVENT-PROTECTION-PROPSS>
                      <SERVICE-INTERFACE-DEPLOYMENT-REF DEST="SOMEIP-SERVICE-INTERFACE-DEPLOYMENT">/apd/ServiceInterfaceDeployments/Radar_Someip</SERVICE-INTERFACE-DEPLOYMENT-REF>
                      <PROVIDED-EVENT-GROUPS>
                        <SOMEIP-PROVIDED-EVENT-GROUP>
                          <SHORT-NAME>RequiredEventgroup1</SHORT-NAME>
                          <EVENT-GROUP-REF DEST="SOMEIP-EVENT-GROUP">/apd/ServiceInterfaceDeployments/Radar_Someip/SomeipEventgroup1</EVENT-GROUP-REF>
                          <MULTICAST-THRESHOLD>0</MULTICAST-THRESHOLD>
                        </SOMEIP-PROVIDED-EVENT-GROUP>
                        <SOMEIP-PROVIDED-EVENT-GROUP>
                          <SHORT-NAME>RequiredEventgroup2</SHORT-NAME>
                          <EVENT-GROUP-REF DEST="SOMEIP-EVENT-GROUP">/apd/ServiceInterfaceDeployments/Radar_Someip/SomeipEventgroup2</EVENT-GROUP-REF>
                          <MULTICAST-THRESHOLD>0</MULTICAST-THRESHOLD>
                        </SOMEIP-PROVIDED-EVENT-GROUP>
                      </PROVIDED-EVENT-GROUPS>
                      <SD-SERVER-CONFIG-REF DEST="SOMEIP-SD-SERVER-SERVICE-INSTANCE-CONFIG">/apd/SomeipSdTimingConfigs/SomeipSdServerServiceInstanceConfig</SD-SERVER-CONFIG-REF>
                      <SERVICE-INSTANCE-ID>19</SERVICE-INSTANCE-ID>
                    </PROVIDED-SOMEIP-SERVICE-INSTANCE>
                  </ELEMENTS>
                </AR-PACKAGE>
              </AR-PACKAGES>
            </AR-PACKAGE>
          </AR-PACKAGES>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
