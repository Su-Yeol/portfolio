<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00052.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>apd</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>Machines</SHORT-NAME>
          <AR-PACKAGES>
            <AR-PACKAGE>
              <SHORT-NAME>testSuiteEcu1WRSOMEIPMachine</SHORT-NAME>
              <AR-PACKAGES>
                <AR-PACKAGE>
                  <!-- ServiceInstanceToMachineMappings -->
                  <SHORT-NAME>ServiceInstanceToMachineMappings</SHORT-NAME>
                  <ELEMENTS>
                    <SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                      <SHORT-NAME>CmService1RequiredServiceInstanceToEcu1Machine</SHORT-NAME>
                      <COMMUNICATION-CONNECTOR-REF DEST="ETHERNET-COMMUNICATION-CONNECTOR">/apd/MachineDesigns/testSuiteEcu1WRSOMEIPMachineDesign/CommunicationWRSOMEIPConnector1</COMMUNICATION-CONNECTOR-REF>
                      <SERVICE-INSTANCE-REFS>
                        <SERVICE-INSTANCE-REF DEST="REQUIRED-SOMEIP-SERVICE-INSTANCE">/apd/Machines/testSuiteEcu1WRSOMEIPMachine/ServiceInstances/ST_CMApp03CMService1RequiredSomeipServiceInstance</SERVICE-INSTANCE-REF>
                      </SERVICE-INSTANCE-REFS>
                      <UDP-PORT-REF DEST="AP-APPLICATION-ENDPOINT">/apd/MachineDesigns/testSuiteEcu1WRSOMEIPMachineDesign/CommunicationWRSOMEIPConnector1/CmService1ApplicationEndpoint</UDP-PORT-REF>
                    </SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                    <SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                      <SHORT-NAME>CMApp03DiagDataIdentifierProvidedServiceInstanceToEcu1Machine</SHORT-NAME>
                      <COMMUNICATION-CONNECTOR-REF DEST="ETHERNET-COMMUNICATION-CONNECTOR">/apd/MachineDesigns/testSuiteEcu1WRSOMEIPMachineDesign/CommunicationWRSOMEIPConnector1</COMMUNICATION-CONNECTOR-REF>
                      <SERVICE-INSTANCE-REFS>
                        <SERVICE-INSTANCE-REF DEST="PROVIDED-SOMEIP-SERVICE-INSTANCE">/apd/Machines/testSuiteEcu1WRSOMEIPMachine/ServiceInstances/ST_CMApp03DiagDataIdentifierProvidedSomeipServiceInstance</SERVICE-INSTANCE-REF>
                      </SERVICE-INSTANCE-REFS>
                      <UDP-PORT-REF DEST="AP-APPLICATION-ENDPOINT">/apd/MachineDesigns/testSuiteEcu1WRSOMEIPMachineDesign/CommunicationWRSOMEIPConnector1/CMApp03DiagDataIdentifierApplicationEndpoint</UDP-PORT-REF>
                    </SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                  </ELEMENTS>
                </AR-PACKAGE>
                <AR-PACKAGE>
                  <!-- ServiceInstances -->
                  <SHORT-NAME>ServiceInstances</SHORT-NAME>
                  <ELEMENTS>
                    <REQUIRED-SOMEIP-SERVICE-INSTANCE>
                      <SHORT-NAME>ST_CMApp03CMService1RequiredSomeipServiceInstance</SHORT-NAME>
                      <SERVICE-INTERFACE-DEPLOYMENT-REF DEST="SOMEIP-SERVICE-INTERFACE-DEPLOYMENT">/apd/ServiceInterfaceDeployments/CMService1_Someip</SERVICE-INTERFACE-DEPLOYMENT-REF>
                      <REQUIRED-SERVICE-INSTANCE-ID>19</REQUIRED-SERVICE-INSTANCE-ID>
                      <SD-CLIENT-CONFIG-REF DEST="SOMEIP-SD-CLIENT-SERVICE-INSTANCE-CONFIG">/apd/SomeipSdTimingConfigs/SomeipSdClientServiceInstanceConfig</SD-CLIENT-CONFIG-REF>
                    </REQUIRED-SOMEIP-SERVICE-INSTANCE>
                    <PROVIDED-SOMEIP-SERVICE-INSTANCE>
                      <SHORT-NAME>ST_CMApp03DiagDataIdentifierProvidedSomeipServiceInstance</SHORT-NAME>
                      <SERVICE-INTERFACE-DEPLOYMENT-REF DEST="SOMEIP-SERVICE-INTERFACE-DEPLOYMENT">/apd/ServiceInterfaceDeployments/DataIdentifier_Someip</SERVICE-INTERFACE-DEPLOYMENT-REF>
                      <SD-SERVER-CONFIG-REF DEST="SOMEIP-SD-SERVER-SERVICE-INSTANCE-CONFIG">/apd/SomeipSdTimingConfigs/SomeipSdServerServiceInstanceConfig</SD-SERVER-CONFIG-REF>
                      <SERVICE-INSTANCE-ID>1001</SERVICE-INSTANCE-ID>
                    </PROVIDED-SOMEIP-SERVICE-INSTANCE>
                  </ELEMENTS>
                </AR-PACKAGE>
              </AR-PACKAGES>
            </AR-PACKAGE>
          </AR-PACKAGES>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
