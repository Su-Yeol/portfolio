<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00052.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>apd</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>AdaptiveApplicationSwComponentTypes</SHORT-NAME>
          <ELEMENTS>
            <ADAPTIVE-APPLICATION-SW-COMPONENT-TYPE>
              <SHORT-NAME>DemoFunction</SHORT-NAME>
              <PORTS>
                <PR-PORT-PROTOTYPE>
                  <SHORT-NAME>PRKvs</SHORT-NAME>
                  <PROVIDED-REQUIRED-INTERFACE-TREF DEST="PERSISTENCY-KEY-VALUE-STORAGE-INTERFACE">/apd/Interfaces/IKvs</PROVIDED-REQUIRED-INTERFACE-TREF>
                </PR-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>TutIf</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SERVICE-INTERFACE">/apd/ServiceInterfaces/TutorialInterface</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
              </PORTS>
            </ADAPTIVE-APPLICATION-SW-COMPONENT-TYPE>
          </ELEMENTS>
        </AR-PACKAGE>
        <AR-PACKAGE>
          <SHORT-NAME>Executables</SHORT-NAME>
          <ELEMENTS>
            <EXECUTABLE>
              <SHORT-NAME>ExtendedTutorial</SHORT-NAME>
              <CATEGORY>APPLICATION_LEVEL</CATEGORY>
              <MINIMUM-TIMER-GRANULARITY>1000.0</MINIMUM-TIMER-GRANULARITY>
              <ROOT-SW-COMPONENT-PROTOTYPE>
                <SHORT-NAME>DemoFunction</SHORT-NAME>
                <APPLICATION-TYPE-TREF DEST="ADAPTIVE-APPLICATION-SW-COMPONENT-TYPE">/apd/AdaptiveApplicationSwComponentTypes/DemoFunction</APPLICATION-TYPE-TREF>
              </ROOT-SW-COMPONENT-PROTOTYPE>
            </EXECUTABLE>
          </ELEMENTS>
        </AR-PACKAGE>
        <AR-PACKAGE>
          <SHORT-NAME>Interfaces</SHORT-NAME>
          <ELEMENTS>
            <PERSISTENCY-KEY-VALUE-STORAGE-INTERFACE>
              <SHORT-NAME>IKvs</SHORT-NAME>
            </PERSISTENCY-KEY-VALUE-STORAGE-INTERFACE>
          </ELEMENTS>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
