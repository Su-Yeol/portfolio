                              <IPV-4-ADDRESS>192.168.7.2</IPV-4-ADDRESS>
                              <NETWORK-MASK>255.255.255.0</NETWORK-MASK>
                            </IPV-4-CONFIGURATION>
                          </NETWORK-ENDPOINT-ADDRESSES>
                        </NETWORK-ENDPOINT>
                        <NETWORK-ENDPOINT>
                          <SHORT-NAME>SDNetworkEndpoint</SHORT-NAME>
                          <FULLY-QUALIFIED-DOMAIN-NAME/>
                          <NETWORK-ENDPOINT-ADDRESSES>
                            <IPV-4-CONFIGURATION>
                              <IPV-4-ADDRESS>224.244.224.245</IPV-4-ADDRESS>
                            </IPV-4-CONFIGURATION>
                          </NETWORK-ENDPOINT-ADDRESSES>
                        </NETWORK-ENDPOINT>
                      </NETWORK-ENDPOINTS>
                    </ETHERNET-PHYSICAL-CHANNEL>
                  </PHYSICAL-CHANNELS>
                </ETHERNET-CLUSTER-CONDITIONAL>
              </ETHERNET-CLUSTER-VARIANTS>
            </ETHERNET-CLUSTER>
