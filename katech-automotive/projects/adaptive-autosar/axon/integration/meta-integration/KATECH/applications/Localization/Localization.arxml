<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://autosar.org/schema/r4.0" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00052.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>katech</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>AdaptiveApplicationSwComponentTypes</SHORT-NAME>
          <ELEMENTS>
            <ADAPTIVE-APPLICATION-SW-COMPONENT-TYPE>
              <SHORT-NAME>Localization</SHORT-NAME>
              <PORTS>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>PPort_collect_fault_localization</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SERVICE-INTERFACE">/katech/collect_fault_localization</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>PPort_matching_info</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SERVICE-INTERFACE">/katech/matching_info</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>PPort_vehicle_location</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SERVICE-INTERFACE">/katech/vehicle_location</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RPort_can_data</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SERVICE-INTERFACE">/katech/can_data</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RPort_can_data_etc</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SERVICE-INTERFACE">/katech/can_data_etc</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RPort_lane_detection</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SERVICE-INTERFACE">/katech/lane_detection</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RPort_local_map</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SERVICE-INTERFACE">/katech/local_map</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RPort_perception_obstacles</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SERVICE-INTERFACE">/katech/perception_obstacles</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RPort_point_map</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SERVICE-INTERFACE">/katech/point_map</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RPort_routing_result</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SERVICE-INTERFACE">/katech/routing_result</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RPort_routing_search</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SERVICE-INTERFACE">/katech/routing_search</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RPort_traffic_light</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SERVICE-INTERFACE">/katech/traffic_light</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RPort_v2x_data</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SERVICE-INTERFACE">/katech/v2x_data</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
              </PORTS>
            </ADAPTIVE-APPLICATION-SW-COMPONENT-TYPE>
          </ELEMENTS>
        </AR-PACKAGE>
        <AR-PACKAGE>
          <SHORT-NAME>Executables</SHORT-NAME>
          <ELEMENTS>
            <EXECUTABLE>
              <SHORT-NAME>Localization</SHORT-NAME>
              <CATEGORY>APPLICATION_LEVEL</CATEGORY>
              <MINIMUM-TIMER-GRANULARITY>1000</MINIMUM-TIMER-GRANULARITY>
              <ROOT-SW-COMPONENT-PROTOTYPE>
                <SHORT-NAME>Localization</SHORT-NAME>
        <APPLICATION-TYPE-TREF DEST="ADAPTIVE-APPLICATION-SW-COMPONENT-TYPE">/katech/AdaptiveApplicationSwComponentTypes/Localization</APPLICATION-TYPE-TREF>
              </ROOT-SW-COMPONENT-PROTOTYPE>
            </EXECUTABLE>
          </ELEMENTS>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
