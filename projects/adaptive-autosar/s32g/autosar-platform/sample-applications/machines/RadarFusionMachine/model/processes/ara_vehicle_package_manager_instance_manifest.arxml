<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00052.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>apd</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>Machines</SHORT-NAME>
          <AR-PACKAGES>
            <AR-PACKAGE>
              <SHORT-NAME>RadarFusionMachine</SHORT-NAME>
              <AR-PACKAGES>
                <AR-PACKAGE>
                  <SHORT-NAME>ServiceInstanceToMachineMappings</SHORT-NAME>
                  <ELEMENTS>
                    <SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                      <SHORT-NAME>VehiclePackageManagementInstanceToMachineMapping</SHORT-NAME>
                      <COMMUNICATION-CONNECTOR-REF DEST="ETHERNET-COMMUNICATION-CONNECTOR">/apd/MachineDesigns/RadarFusionMachineDesign/RadarFusionConnector</COMMUNICATION-CONNECTOR-REF>
                      <SERVICE-INSTANCE-REFS>
                        <SERVICE-INSTANCE-REF DEST="PROVIDED-SOMEIP-SERVICE-INSTANCE">/apd/Machines/RadarFusionMachine/ServiceInstances/ProvidedSomeIpVehicleDriverApplicationInterfaceInstance</SERVICE-INSTANCE-REF>
                        <SERVICE-INSTANCE-REF DEST="PROVIDED-SOMEIP-SERVICE-INSTANCE">/apd/Machines/RadarFusionMachine/ServiceInstances/ProvidedSomeIpVehiclePackageManagementInstance</SERVICE-INSTANCE-REF>
                        <SERVICE-INSTANCE-REF DEST="PROVIDED-SOMEIP-SERVICE-INSTANCE">/apd/Machines/RadarFusionMachine/ServiceInstances/ProvidedSomeIpVehicleStateManagerInterfaceInstance</SERVICE-INSTANCE-REF>
                      </SERVICE-INSTANCE-REFS>
                      <TCP-PORT-REF DEST="AP-APPLICATION-ENDPOINT">/apd/MachineDesigns/RadarFusionMachineDesign/RadarFusionConnector/VehiclePackageManagementApplicationEndpoint</TCP-PORT-REF>
                    </SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                    <SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                      <SHORT-NAME>PackageManagementInstanceToMachineMappingForVPM</SHORT-NAME>
                      <COMMUNICATION-CONNECTOR-REF DEST="ETHERNET-COMMUNICATION-CONNECTOR">/apd/MachineDesigns/RadarFusionMachineDesign/RadarFusionConnector</COMMUNICATION-CONNECTOR-REF>
                      <SERVICE-INSTANCE-REFS>
                        <SERVICE-INSTANCE-REF DEST="PROVIDED-SOMEIP-SERVICE-INSTANCE">/apd/Machines/RadarFusionMachine/ServiceInstances/RequiredSomeIpPackageManagementInstanceForVehiclePackageManager</SERVICE-INSTANCE-REF>
                      </SERVICE-INSTANCE-REFS>
                    </SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                  </ELEMENTS>
                </AR-PACKAGE>
                <AR-PACKAGE>
                  <SHORT-NAME>ServiceInstances</SHORT-NAME>
                  <ELEMENTS>
                    <PROVIDED-SOMEIP-SERVICE-INSTANCE>
                      <SHORT-NAME>ProvidedSomeIpVehicleDriverApplicationInterfaceInstance</SHORT-NAME>
                      <SERVICE-INTERFACE-DEPLOYMENT-REF DEST="SOMEIP-SERVICE-INTERFACE-DEPLOYMENT">/ara/apd/ucm_master/deployment/VehicleDriverApplicationInterfaceSomeIp</SERVICE-INTERFACE-DEPLOYMENT-REF>
                      <PROVIDED-EVENT-GROUPS>
                        <SOMEIP-PROVIDED-EVENT-GROUP>
                          <SHORT-NAME>ApprovalRequired_provided_eventgroup</SHORT-NAME>
                          <EVENT-GROUP-REF DEST="SOMEIP-EVENT-GROUP">/ara/apd/ucm_master/deployment/VehicleDriverApplicationInterfaceSomeIp/ApprovalRequired_eventgroup</EVENT-GROUP-REF>
                          <MULTICAST-THRESHOLD>0</MULTICAST-THRESHOLD>
                        </SOMEIP-PROVIDED-EVENT-GROUP>
                        <SOMEIP-PROVIDED-EVENT-GROUP>
                          <SHORT-NAME>CampaignState_provided_eventgroup</SHORT-NAME>
                          <EVENT-GROUP-REF DEST="SOMEIP-EVENT-GROUP">/ara/apd/ucm_master/deployment/VehicleDriverApplicationInterfaceSomeIp/CampaignState_eventgroup</EVENT-GROUP-REF>
                          <MULTICAST-THRESHOLD>0</MULTICAST-THRESHOLD>
                        </SOMEIP-PROVIDED-EVENT-GROUP>
                        <SOMEIP-PROVIDED-EVENT-GROUP>
                          <SHORT-NAME>VehicleConditionCollection_provided_eventgroup</SHORT-NAME>
                          <EVENT-GROUP-REF DEST="SOMEIP-EVENT-GROUP">/ara/apd/ucm_master/deployment/VehicleDriverApplicationInterfaceSomeIp/VehicleConditionCollection_eventgroup</EVENT-GROUP-REF>
                          <MULTICAST-THRESHOLD>0</MULTICAST-THRESHOLD>
                        </SOMEIP-PROVIDED-EVENT-GROUP>
                      </PROVIDED-EVENT-GROUPS>
                      <SD-SERVER-CONFIG-REF DEST="SOMEIP-SD-SERVER-SERVICE-INSTANCE-CONFIG">/apd/SomeipSdTimingConfigs/SomeipSdServerServiceInstanceConfig</SD-SERVER-CONFIG-REF>
                      <SERVICE-INSTANCE-ID>910</SERVICE-INSTANCE-ID>
                    </PROVIDED-SOMEIP-SERVICE-INSTANCE>
                    <PROVIDED-SOMEIP-SERVICE-INSTANCE>
                      <SHORT-NAME>ProvidedSomeIpVehiclePackageManagementInstance</SHORT-NAME>
                      <SERVICE-INTERFACE-DEPLOYMENT-REF DEST="SOMEIP-SERVICE-INTERFACE-DEPLOYMENT">/ara/apd/ucm_master/deployment/VehiclePackageManagementSomeIp</SERVICE-INTERFACE-DEPLOYMENT-REF>
                      <PROVIDED-EVENT-GROUPS>
                        <SOMEIP-PROVIDED-EVENT-GROUP>
                          <SHORT-NAME>RequestedPackage_provided_eventgroup</SHORT-NAME>
                          <EVENT-GROUP-REF DEST="SOMEIP-EVENT-GROUP">/ara/apd/ucm_master/deployment/VehiclePackageManagementSomeIp/RequestedPackage_eventgroup</EVENT-GROUP-REF>
                          <MULTICAST-THRESHOLD>0</MULTICAST-THRESHOLD>
                        </SOMEIP-PROVIDED-EVENT-GROUP>
                        <SOMEIP-PROVIDED-EVENT-GROUP>
                          <SHORT-NAME>TransferState_provided_eventgroup</SHORT-NAME>
                          <EVENT-GROUP-REF DEST="SOMEIP-EVENT-GROUP">/ara/apd/ucm_master/deployment/VehiclePackageManagementSomeIp/TransferState_eventgroup</EVENT-GROUP-REF>
                          <MULTICAST-THRESHOLD>0</MULTICAST-THRESHOLD>
                        </SOMEIP-PROVIDED-EVENT-GROUP>
                        <SOMEIP-PROVIDED-EVENT-GROUP>
                          <SHORT-NAME>VehicleConditionCollection_provided_eventgroup</SHORT-NAME>
                          <EVENT-GROUP-REF DEST="SOMEIP-EVENT-GROUP">/ara/apd/ucm_master/deployment/VehiclePackageManagementSomeIp/VehicleConditionCollection_eventgroup</EVENT-GROUP-REF>
                          <MULTICAST-THRESHOLD>0</MULTICAST-THRESHOLD>
                        </SOMEIP-PROVIDED-EVENT-GROUP>
                      </PROVIDED-EVENT-GROUPS>
                      <SD-SERVER-CONFIG-REF DEST="SOMEIP-SD-SERVER-SERVICE-INSTANCE-CONFIG">/apd/SomeipSdTimingConfigs/SomeipSdServerServiceInstanceConfig</SD-SERVER-CONFIG-REF>
                      <SERVICE-INSTANCE-ID>909</SERVICE-INSTANCE-ID>
                    </PROVIDED-SOMEIP-SERVICE-INSTANCE>
                    <PROVIDED-SOMEIP-SERVICE-INSTANCE>
                      <SHORT-NAME>ProvidedSomeIpVehicleStateManagerInterfaceInstance</SHORT-NAME>
                      <SERVICE-INTERFACE-DEPLOYMENT-REF DEST="SOMEIP-SERVICE-INTERFACE-DEPLOYMENT">/ara/apd/ucm_master/deployment/VehicleStateManagerInterfaceSomeIp</SERVICE-INTERFACE-DEPLOYMENT-REF>
                      <PROVIDED-EVENT-GROUPS>
                        <SOMEIP-PROVIDED-EVENT-GROUP>
                          <SHORT-NAME>VehicleConditionCollection_provided_eventgroup</SHORT-NAME>
                          <EVENT-GROUP-REF DEST="SOMEIP-EVENT-GROUP">/ara/apd/ucm_master/deployment/VehicleStateManagerInterfaceSomeIp/VehicleConditionCollection_eventgroup</EVENT-GROUP-REF>
                          <MULTICAST-THRESHOLD>0</MULTICAST-THRESHOLD>
                        </SOMEIP-PROVIDED-EVENT-GROUP>
                      </PROVIDED-EVENT-GROUPS>
                      <SD-SERVER-CONFIG-REF DEST="SOMEIP-SD-SERVER-SERVICE-INSTANCE-CONFIG">/apd/SomeipSdTimingConfigs/SomeipSdServerServiceInstanceConfig</SD-SERVER-CONFIG-REF>
                      <SERVICE-INSTANCE-ID>911</SERVICE-INSTANCE-ID>
                    </PROVIDED-SOMEIP-SERVICE-INSTANCE>
                    <REQUIRED-SOMEIP-SERVICE-INSTANCE>
                      <SHORT-NAME>RequiredSomeIpPackageManagementInstanceForVehiclePackageManager</SHORT-NAME>
                      <SERVICE-INTERFACE-DEPLOYMENT-REF DEST="SOMEIP-SERVICE-INTERFACE-DEPLOYMENT">/ara/apd/ucm/deployment/PackageManagementSomeIp</SERVICE-INTERFACE-DEPLOYMENT-REF>
                      <REQUIRED-EVENT-GROUPS>
                        <SOMEIP-REQUIRED-EVENT-GROUP>
                          <SHORT-NAME>CurrentStatus_required_eventgroup</SHORT-NAME>
                          <EVENT-GROUP-REF DEST="SOMEIP-EVENT-GROUP">/ara/apd/ucm/deployment/PackageManagementSomeIp/CurrentStatus_eventgroup</EVENT-GROUP-REF>
                        </SOMEIP-REQUIRED-EVENT-GROUP>
                      </REQUIRED-EVENT-GROUPS>
                      <REQUIRED-MINOR-VERSION>0</REQUIRED-MINOR-VERSION>
                      <REQUIRED-SERVICE-INSTANCE-ID>ANY</REQUIRED-SERVICE-INSTANCE-ID>
                      <SD-CLIENT-CONFIG-REF DEST="SOMEIP-SD-CLIENT-SERVICE-INSTANCE-CONFIG">/apd/SomeipSdTimingConfigs/SomeipSdClientServiceInstanceConfig</SD-CLIENT-CONFIG-REF>
                    </REQUIRED-SOMEIP-SERVICE-INSTANCE>
                  </ELEMENTS>
                </AR-PACKAGE>
              </AR-PACKAGES>
            </AR-PACKAGE>
          </AR-PACKAGES>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
