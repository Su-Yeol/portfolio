<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00052.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>apd</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>Machines</SHORT-NAME>
          <AR-PACKAGES>
            <AR-PACKAGE>
              <SHORT-NAME>RadarFusionMachine</SHORT-NAME>
              <AR-PACKAGES>
                <AR-PACKAGE>
                  <SHORT-NAME>ProcessToMachineMappings</SHORT-NAME>
                  <ELEMENTS>
                    <PROCESS-TO-MACHINE-MAPPING-SET>
                      <SHORT-NAME>EmoIntegrationTest</SHORT-NAME>
                      <PROCESS-TO-MACHINE-MAPPINGS>
                        <PROCESS-TO-MACHINE-MAPPING>
                          <SHORT-NAME>EmoIntegrationTest</SHORT-NAME>
                          <MACHINE-REF DEST="MACHINE">/apd/Machines/RadarFusionMachine/RadarFusionMachine</MACHINE-REF>
                          <PROCESS-REF DEST="PROCESS">/apd/Machines/RadarFusionMachine/Processes/EmoIntegrationTest</PROCESS-REF>
                          <SHALL-RUN-ON-REFS>
                            <SHALL-RUN-ON-REF DEST="PROCESSOR-CORE">/apd/Machines/RadarFusionMachine/RadarFusionMachine/DefaultProcessor/ProcessorCore0</SHALL-RUN-ON-REF>
                            <SHALL-RUN-ON-REF DEST="PROCESSOR-CORE">/apd/Machines/RadarFusionMachine/RadarFusionMachine/DefaultProcessor/ProcessorCore1</SHALL-RUN-ON-REF>
                          </SHALL-RUN-ON-REFS>
                        </PROCESS-TO-MACHINE-MAPPING>
                      </PROCESS-TO-MACHINE-MAPPINGS>
                    </PROCESS-TO-MACHINE-MAPPING-SET>
                  </ELEMENTS>
                </AR-PACKAGE>
                <AR-PACKAGE>
                  <SHORT-NAME>DltLogChannelToProcessMappings</SHORT-NAME>
                  <ELEMENTS>
                    <DLT-APPLICATION-TO-PROCESS-MAPPING>
                      <SHORT-NAME>EmoIntegrationTestDltApplicationToProcessMapping</SHORT-NAME>
                      <DLT-APPLICATION-REF DEST="DLT-APPLICATION">/apd/Machines/RadarFusionMachine/Dlt/RadarFusionDltEcu/EmoIntegrationTestApplication</DLT-APPLICATION-REF>
                      <PROCESS-REF DEST="PROCESS">/apd/Machines/RadarFusionMachine/Processes/EmoIntegrationTest</PROCESS-REF>
                    </DLT-APPLICATION-TO-PROCESS-MAPPING>
                    <DLT-LOG-SINK-TO-PORT-PROTOTYPE-MAPPING>
                      <SHORT-NAME>EmoIntegrationTestDltLogSinkToPortPrototypeMapping</SHORT-NAME>
                      <DLT-CONTEXT-REF DEST="DLT-CONTEXT">/apd/Dlt/DefaultDltContext</DLT-CONTEXT-REF>
                      <DLT-LOG-SINK-REFS>
                        <DLT-LOG-SINK-REF DEST="DLT-LOG-SINK">/apd/Machines/RadarFusionMachine/Dlt/ConsoleDltSink</DLT-LOG-SINK-REF>
                        <DLT-LOG-SINK-REF DEST="DLT-LOG-SINK">/apd/Dlt/EmoIntegrationTestLogFileDltSink</DLT-LOG-SINK-REF>
                        <DLT-LOG-SINK-REF DEST="DLT-LOG-SINK">/apd/Dlt/RemoteDltSink</DLT-LOG-SINK-REF>
                      </DLT-LOG-SINK-REFS>
                      <PROCESS-REF DEST="PROCESS">/apd/Machines/RadarFusionMachine/Processes/EmoIntegrationTest</PROCESS-REF>
                    </DLT-LOG-SINK-TO-PORT-PROTOTYPE-MAPPING>
                  </ELEMENTS>
                </AR-PACKAGE>
                <AR-PACKAGE>
                  <SHORT-NAME>Processes</SHORT-NAME>
                  <ELEMENTS>
                    <PROCESS>
                      <SHORT-NAME>EmoIntegrationTest</SHORT-NAME>
                      <DESIGN-REF DEST="PROCESS-DESIGN">/apd/Machines/RadarFusionMachine/ProcessDesigns/EmoIntegrationTestDesign</DESIGN-REF>
                      <EXECUTABLE-REFS>
                        <EXECUTABLE-REF DEST="EXECUTABLE">/apd/Executables/EmoIntegrationTest</EXECUTABLE-REF>
                      </EXECUTABLE-REFS>
                      <PROCESS-STATE-MACHINE>
                        <SHORT-NAME>state_machine</SHORT-NAME>
                        <TYPE-TREF DEST="MODE-DECLARATION-GROUP">/apd/ModeDeclarationGroups/ProcessStateMachine</TYPE-TREF>
                      </PROCESS-STATE-MACHINE>
                      <STATE-DEPENDENT-STARTUP-CONFIGS>
                        <STATE-DEPENDENT-STARTUP-CONFIG>
                          <FUNCTION-GROUP-STATE-IREFS>
                            <FUNCTION-GROUP-STATE-IREF>
                              <CONTEXT-MODE-DECLARATION-GROUP-PROTOTYPE-REF DEST="MODE-DECLARATION-GROUP-PROTOTYPE">/apd/Machines/RadarFusionMachine/FunctionGroupSets/RadarFusionFunctionGroups/MachineFG</CONTEXT-MODE-DECLARATION-GROUP-PROTOTYPE-REF>
                              <TARGET-MODE-DECLARATION-REF DEST="MODE-DECLARATION">/apd/ModeDeclarationGroups/MachineState/Driving</TARGET-MODE-DECLARATION-REF>
                            </FUNCTION-GROUP-STATE-IREF>
                          </FUNCTION-GROUP-STATE-IREFS>
                          <RESOURCE-GROUP-REF DEST="RESOURCE-GROUP">/apd/Machines/RadarFusionMachine/RadarFusionMachine/Linux/ResourceGroup1</RESOURCE-GROUP-REF>
                          <STARTUP-CONFIG-REF DEST="STARTUP-CONFIG">/apd/Machines/RadarFusionMachine/StartupConfigs/ConfigDriving</STARTUP-CONFIG-REF>
                        </STATE-DEPENDENT-STARTUP-CONFIG>
                      </STATE-DEPENDENT-STARTUP-CONFIGS>
                    </PROCESS>
                  </ELEMENTS>
                </AR-PACKAGE>
                <AR-PACKAGE>
                  <SHORT-NAME>ProcessDesigns</SHORT-NAME>
                  <ELEMENTS>
                    <PROCESS-DESIGN>
                      <SHORT-NAME>EmoIntegrationTestDesign</SHORT-NAME>
                      <EXECUTABLE-REFS>
                        <EXECUTABLE-REF DEST="EXECUTABLE">/apd/Executables/EmoIntegrationTest</EXECUTABLE-REF>
                      </EXECUTABLE-REFS>
                    </PROCESS-DESIGN>
                  </ELEMENTS>
                </AR-PACKAGE>
                <AR-PACKAGE>
                  <SHORT-NAME>StartupConfigs</SHORT-NAME>
                  <ELEMENTS>
                    <STARTUP-CONFIG>
                      <SHORT-NAME>ConfigDriving</SHORT-NAME>
                      <ENVIRONMENT-VARIABLES>
                        <TAG-WITH-OPTIONAL-VALUE>
                          <KEY>DLT_LOG_MODE</KEY>
                          <VALUE>3</VALUE>
                        </TAG-WITH-OPTIONAL-VALUE>
                      </ENVIRONMENT-VARIABLES>
                      <EXECUTION-ERROR-REF DEST="PROCESS-EXECUTION-ERROR">/apd/Machines/RadarFusionMachine/EmoIntegrationTestExecErrors/EmoIntegrationTestExecutionError</EXECUTION-ERROR-REF>
                      <PROCESS-ARGUMENTS>
                        <PROCESS-ARGUMENT>
                          <ARGUMENT>Argument 1</ARGUMENT>
                        </PROCESS-ARGUMENT>
                        <PROCESS-ARGUMENT>
                          <ARGUMENT>Argument 2</ARGUMENT>
                        </PROCESS-ARGUMENT>
                        <PROCESS-ARGUMENT>
                          <ARGUMENT>Argument 3</ARGUMENT>
                        </PROCESS-ARGUMENT>
                      </PROCESS-ARGUMENTS>
                      <SCHEDULING-POLICY>SCHED_RR</SCHEDULING-POLICY>
                      <SCHEDULING-PRIORITY>12</SCHEDULING-PRIORITY>
                      <TERMINATION-BEHAVIOR>PROCESS-IS-SELF-TERMINATING</TERMINATION-BEHAVIOR>
                    </STARTUP-CONFIG>
                  </ELEMENTS>
                </AR-PACKAGE>
                <AR-PACKAGE>
                  <SHORT-NAME>EmoIntegrationTestExecErrors</SHORT-NAME>
                  <ELEMENTS>
                    <PROCESS-EXECUTION-ERROR>
                      <SHORT-NAME>EmoIntegrationTestExecutionError</SHORT-NAME>
                      <EXECUTION-ERROR>5</EXECUTION-ERROR>
                    </PROCESS-EXECUTION-ERROR>
                  </ELEMENTS>
                </AR-PACKAGE>
              </AR-PACKAGES>
            </AR-PACKAGE>
          </AR-PACKAGES>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
