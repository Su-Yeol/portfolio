<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00052.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>apd</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>Machines</SHORT-NAME>
          <AR-PACKAGES>
            <AR-PACKAGE>
              <SHORT-NAME>FusionMachine</SHORT-NAME>
              <AR-PACKAGES>
                <AR-PACKAGE>
                  <SHORT-NAME>ServiceInstanceToMachineMappings</SHORT-NAME>
                  <ELEMENTS>
                    <SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                      <SHORT-NAME>RequiredControllerInstanceToMachineMapping</SHORT-NAME>
                      <COMMUNICATION-CONNECTOR-REF DEST="ETHERNET-COMMUNICATION-CONNECTOR">/apd/MachineDesigns/FusionMachineDesign/FusionConnector</COMMUNICATION-CONNECTOR-REF>
                      <SERVICE-INSTANCE-REFS>
                        <SERVICE-INSTANCE-REF DEST="REQUIRED-SOMEIP-SERVICE-INSTANCE">/apd/Machines/FusionMachine/ServiceInstances/RequiredSomeIpActorInstance</SERVICE-INSTANCE-REF>
                        <SERVICE-INSTANCE-REF DEST="REQUIRED-SOMEIP-SERVICE-INSTANCE">/apd/Machines/FusionMachine/ServiceInstances/RequiredSomeIpLineSensorInstance</SERVICE-INSTANCE-REF>
                        <SERVICE-INSTANCE-REF DEST="REQUIRED-SOMEIP-SERVICE-INSTANCE">/apd/Machines/FusionMachine/ServiceInstances/RequiredSomeIpUltraSonicSensorInstance</SERVICE-INSTANCE-REF>
                      </SERVICE-INSTANCE-REFS>
                    </SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                  </ELEMENTS>
                </AR-PACKAGE>
                <AR-PACKAGE>
                  <SHORT-NAME>ServiceInstances</SHORT-NAME>
                  <ELEMENTS>
                    <REQUIRED-SOMEIP-SERVICE-INSTANCE>
                      <SHORT-NAME>RequiredSomeIpActorInstance</SHORT-NAME>
                      <SERVICE-INTERFACE-DEPLOYMENT-REF DEST="SOMEIP-SERVICE-INTERFACE-DEPLOYMENT">/apd/ServiceInterfaceDeployments/ActorServInterfaceSomeIp</SERVICE-INTERFACE-DEPLOYMENT-REF>
                      <REQUIRED-MINOR-VERSION>0</REQUIRED-MINOR-VERSION>
                      <REQUIRED-SERVICE-INSTANCE-ID>20545</REQUIRED-SERVICE-INSTANCE-ID>
                      <SD-CLIENT-CONFIG-REF DEST="SOMEIP-SD-CLIENT-SERVICE-INSTANCE-CONFIG">/apd/SomeipSdTimingConfigs/SomeipSdClientServiceInstanceConfig</SD-CLIENT-CONFIG-REF>
                    </REQUIRED-SOMEIP-SERVICE-INSTANCE>
                    <REQUIRED-SOMEIP-SERVICE-INSTANCE>
                      <SHORT-NAME>RequiredSomeIpLineSensorInstance</SHORT-NAME>
                      <SERVICE-INTERFACE-DEPLOYMENT-REF DEST="SOMEIP-SERVICE-INTERFACE-DEPLOYMENT">/apd/ServiceInterfaceDeployments/LineSensorSomeIp</SERVICE-INTERFACE-DEPLOYMENT-REF>
                      <REQUIRED-EVENT-GROUPS>
                        <SOMEIP-REQUIRED-EVENT-GROUP>
                          <SHORT-NAME>LineSensorEvent</SHORT-NAME>
                          <EVENT-GROUP-REF DEST="SOMEIP-EVENT-GROUP">/apd/ServiceInterfaceDeployments/LineSensorSomeIp/LineSensorEventGroup</EVENT-GROUP-REF>
                        </SOMEIP-REQUIRED-EVENT-GROUP>
                      </REQUIRED-EVENT-GROUPS>
                      <REQUIRED-MINOR-VERSION>0</REQUIRED-MINOR-VERSION>
                      <REQUIRED-SERVICE-INSTANCE-ID>20556</REQUIRED-SERVICE-INSTANCE-ID>
                      <SD-CLIENT-CONFIG-REF DEST="SOMEIP-SD-CLIENT-SERVICE-INSTANCE-CONFIG">/apd/SomeipSdTimingConfigs/SomeipSdClientServiceInstanceConfig</SD-CLIENT-CONFIG-REF>
                    </REQUIRED-SOMEIP-SERVICE-INSTANCE>
                    <REQUIRED-SOMEIP-SERVICE-INSTANCE>
                      <SHORT-NAME>RequiredSomeIpUltraSonicSensorInstance</SHORT-NAME>
                      <SERVICE-INTERFACE-DEPLOYMENT-REF DEST="SOMEIP-SERVICE-INTERFACE-DEPLOYMENT">/apd/ServiceInterfaceDeployments/UltraSonicSensorSomeIp</SERVICE-INTERFACE-DEPLOYMENT-REF>
                      <REQUIRED-EVENT-GROUPS>
                        <SOMEIP-REQUIRED-EVENT-GROUP>
                          <SHORT-NAME>UltraSonicSensorEvent</SHORT-NAME>
                          <EVENT-GROUP-REF DEST="SOMEIP-EVENT-GROUP">/apd/ServiceInterfaceDeployments/UltraSonicSensorSomeIp/UltraSonicSensorEventGroup</EVENT-GROUP-REF>
                        </SOMEIP-REQUIRED-EVENT-GROUP>
                      </REQUIRED-EVENT-GROUPS>
                      <REQUIRED-MINOR-VERSION>0</REQUIRED-MINOR-VERSION>
                      <REQUIRED-SERVICE-INSTANCE-ID>20565</REQUIRED-SERVICE-INSTANCE-ID>
                      <SD-CLIENT-CONFIG-REF DEST="SOMEIP-SD-CLIENT-SERVICE-INSTANCE-CONFIG">/apd/SomeipSdTimingConfigs/SomeipSdClientServiceInstanceConfig</SD-CLIENT-CONFIG-REF>
                    </REQUIRED-SOMEIP-SERVICE-INSTANCE>
                  </ELEMENTS>
                </AR-PACKAGE>
              </AR-PACKAGES>
            </AR-PACKAGE>
          </AR-PACKAGES>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
