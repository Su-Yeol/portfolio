<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00052.xsd">
    <AR-PACKAGES>
        <AR-PACKAGE>
            <SHORT-NAME>katech</SHORT-NAME>
            <ELEMENTS>
                <SERVICE-INTERFACE>
                    <SHORT-NAME>driving_trajectory</SHORT-NAME>
                    <NAMESPACES>
                        <SYMBOL-PROPS>
                            <SHORT-NAME>katech</SHORT-NAME>
                            <SYMBOL>katech</SYMBOL>
                        </SYMBOL-PROPS>
                    </NAMESPACES>
                    <EVENTS>
                        <VARIABLE-DATA-PROTOTYPE>
                            <SHORT-NAME>drivingTrajectoryEvent</SHORT-NAME>
                            <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/katech/events/driving_trajectory_Objects</TYPE-TREF>
                        </VARIABLE-DATA-PROTOTYPE>
                    </EVENTS>
                </SERVICE-INTERFACE>
            </ELEMENTS>
            <AR-PACKAGES>
                <AR-PACKAGE>
                    <SHORT-NAME>events</SHORT-NAME>
                    <ELEMENTS>
                        <STD-CPP-IMPLEMENTATION-DATA-TYPE>
                            <SHORT-NAME>driving_trajectory_Objects</SHORT-NAME>
                            <CATEGORY>STRUCTURE</CATEGORY>
                            <NAMESPACES>
                                <SYMBOL-PROPS>
                                    <SHORT-NAME>katech</SHORT-NAME>
                                    <SYMBOL>katech</SYMBOL>
                                </SYMBOL-PROPS>
                            </NAMESPACES>
                            <SUB-ELEMENTS>
                                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                                    <SHORT-NAME>TrajectoryPointVector</SHORT-NAME>
                                    <TYPE-REFERENCE>
                                        <INPLACE>false</INPLACE>
                                        <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/katech/events/TrajectoryPointArray</TYPE-REFERENCE-REF>
                                    </TYPE-REFERENCE>
                                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                                
                                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                                    <SHORT-NAME>Position</SHORT-NAME>
                                    <TYPE-REFERENCE>
                                        <INPLACE>false</INPLACE>
                                        <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/katech/events/Vector3DStruct</TYPE-REFERENCE-REF>
                                    </TYPE-REFERENCE>
                                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>

                                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                                    <SHORT-NAME>Target_speed</SHORT-NAME>
                                    <TYPE-REFERENCE>
                                        <INPLACE>false</INPLACE>
                                        <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/double</TYPE-REFERENCE-REF>
                                    </TYPE-REFERENCE>
                                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>

                                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                                    <SHORT-NAME>Drive_Mode</SHORT-NAME>
                                    <TYPE-REFERENCE>
                                        <INPLACE>false</INPLACE>
                                        <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/bool</TYPE-REFERENCE-REF>
                                    </TYPE-REFERENCE>
                                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>

                                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                                    <SHORT-NAME>Emergency_acceleration</SHORT-NAME>
                                    <TYPE-REFERENCE>
                                        <INPLACE>false</INPLACE>
                                        <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/double</TYPE-REFERENCE-REF>
                                    </TYPE-REFERENCE>
                                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>

                                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                                    <SHORT-NAME>Turn_Signal</SHORT-NAME>
                                    <TYPE-REFERENCE>
                                        <INPLACE>false</INPLACE>
                                        <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint8_t</TYPE-REFERENCE-REF>
                                    </TYPE-REFERENCE>
                                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>

                                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                                    <SHORT-NAME>High_Way</SHORT-NAME>
                                    <TYPE-REFERENCE>
                                        <INPLACE>false</INPLACE>
                                        <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint8_t</TYPE-REFERENCE-REF>
                                    </TYPE-REFERENCE>
                                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                            </SUB-ELEMENTS>
                            <TYPE-EMITTER>TYPE_EMITTER_ARA</TYPE-EMITTER>
                        </STD-CPP-IMPLEMENTATION-DATA-TYPE>

                        <STD-CPP-IMPLEMENTATION-DATA-TYPE>
                            <SHORT-NAME>TrajectoryPointArray</SHORT-NAME>
                            <CATEGORY>VECTOR</CATEGORY>
                            <TEMPLATE-ARGUMENTS>
                                <CPP-TEMPLATE-ARGUMENT>
                                    <TEMPLATE-TYPE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/katech/events/TrajectoryPoint</TEMPLATE-TYPE-REF>
                                </CPP-TEMPLATE-ARGUMENT>
                            </TEMPLATE-ARGUMENTS>
                            <TYPE-EMITTER>TYPE_EMITTER_ARA</TYPE-EMITTER>
                        </STD-CPP-IMPLEMENTATION-DATA-TYPE>

                        <STD-CPP-IMPLEMENTATION-DATA-TYPE>
                            <SHORT-NAME>TrajectoryPoint</SHORT-NAME>
                            <CATEGORY>STRUCTURE</CATEGORY>
                            <NAMESPACES>
                                <SYMBOL-PROPS>
                                    <SHORT-NAME>katech</SHORT-NAME>
                                    <SYMBOL>katech</SYMBOL>
                                </SYMBOL-PROPS>
                            </NAMESPACES>
                            <SUB-ELEMENTS>
                                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                                    <SHORT-NAME>Vector3D</SHORT-NAME>
                                    <TYPE-REFERENCE>
                                        <INPLACE>false</INPLACE>
                                        <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/katech/events/Vector3DStruct</TYPE-REFERENCE-REF>
                                    </TYPE-REFERENCE>
                                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                            </SUB-ELEMENTS>
                            <TYPE-EMITTER>TYPE_EMITTER_ARA</TYPE-EMITTER>
                        </STD-CPP-IMPLEMENTATION-DATA-TYPE>

                        <STD-CPP-IMPLEMENTATION-DATA-TYPE>
                            <SHORT-NAME>Vector3DStruct</SHORT-NAME>
                            <CATEGORY>STRUCTURE</CATEGORY>
                            <NAMESPACES>
                                <SYMBOL-PROPS>
                                    <SHORT-NAME>katech</SHORT-NAME>
                                    <SYMBOL>katech</SYMBOL>
                                </SYMBOL-PROPS>
                            </NAMESPACES>
                            <SUB-ELEMENTS>
                                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                                    <SHORT-NAME>x</SHORT-NAME>
                                    <TYPE-REFERENCE>
                                        <INPLACE>false</INPLACE>
                                        <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/double</TYPE-REFERENCE-REF>
                                    </TYPE-REFERENCE>
                                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                                    <SHORT-NAME>y</SHORT-NAME>
                                    <TYPE-REFERENCE>
                                        <INPLACE>false</INPLACE>
                                        <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/double</TYPE-REFERENCE-REF>
                                    </TYPE-REFERENCE>
                                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                                    <SHORT-NAME>yaw</SHORT-NAME>
                                    <TYPE-REFERENCE>
                                        <INPLACE>false</INPLACE>
                                        <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/double</TYPE-REFERENCE-REF>
                                    </TYPE-REFERENCE>
                                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                            </SUB-ELEMENTS>
                            <TYPE-EMITTER>TYPE_EMITTER_ARA</TYPE-EMITTER>
                        </STD-CPP-IMPLEMENTATION-DATA-TYPE>

                    </ELEMENTS>
                </AR-PACKAGE>
            </AR-PACKAGES>
        </AR-PACKAGE>
    </AR-PACKAGES>
</AUTOSAR>
