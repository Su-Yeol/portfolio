<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00052.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>katech</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>Machines</SHORT-NAME>
          <AR-PACKAGES>
            <AR-PACKAGE>
              <SHORT-NAME>AdaptiveMachine</SHORT-NAME>
              <AR-PACKAGES>
                <AR-PACKAGE>
                  <SHORT-NAME>ServiceInstanceToMachineMappings</SHORT-NAME>
                  <ELEMENTS>
                    <SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                      <SHORT-NAME>ProvidedServiceInstance_toMachine_local_map</SHORT-NAME>
                      <COMMUNICATION-CONNECTOR-REF DEST="ETHERNET-COMMUNICATION-CONNECTOR">/katech/MachineDesigns/AdaptiveMachineDesign/AdaptiveMachineConnector</COMMUNICATION-CONNECTOR-REF>
                      <SERVICE-INSTANCE-REFS>
                        <SERVICE-INSTANCE-REF DEST="PROVIDED-SOMEIP-SERVICE-INSTANCE">/katech/Machines/AdaptiveMachine/ServiceInstances/ProvidedSomeipServiceInstance_local_map</SERVICE-INSTANCE-REF>
                      </SERVICE-INSTANCE-REFS>
                      <UDP-PORT-REF DEST="AP-APPLICATION-ENDPOINT">/katech/MachineDesigns/AdaptiveMachineDesign/AdaptiveMachineConnector/LocalMapProviderEndpoint</UDP-PORT-REF>
                    </SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                    <SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                      <SHORT-NAME>RequiredServiceInstance_toMachine_local_map</SHORT-NAME>
                      <COMMUNICATION-CONNECTOR-REF DEST="ETHERNET-COMMUNICATION-CONNECTOR">/katech/MachineDesigns/AdaptiveMachineDesign/AdaptiveMachineConnector</COMMUNICATION-CONNECTOR-REF>
                      <SERVICE-INSTANCE-REFS>
                        <SERVICE-INSTANCE-REF DEST="REQUIRED-SOMEIP-SERVICE-INSTANCE">/katech/Machines/AdaptiveMachine/ServiceInstances/RequiredSomeipServiceInstance_local_map</SERVICE-INSTANCE-REF>
                      </SERVICE-INSTANCE-REFS>
                      <UDP-PORT-REF DEST="AP-APPLICATION-ENDPOINT">/katech/MachineDesigns/AdaptiveMachineDesign/AdaptiveMachineConnector/LocalMapSubscriberEndpoint</UDP-PORT-REF>
                    </SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                  </ELEMENTS>
                </AR-PACKAGE>
                <AR-PACKAGE>
                  <SHORT-NAME>ServiceInstances</SHORT-NAME>
                  <ELEMENTS>
                    <PROVIDED-SOMEIP-SERVICE-INSTANCE>
                      <SHORT-NAME>ProvidedSomeipServiceInstance_local_map</SHORT-NAME>
                      <SERVICE-INTERFACE-DEPLOYMENT-REF DEST="SOMEIP-SERVICE-INTERFACE-DEPLOYMENT">/katech/deployment/someip_local_map</SERVICE-INTERFACE-DEPLOYMENT-REF>
                      <PROVIDED-EVENT-GROUPS>
                        <SOMEIP-PROVIDED-EVENT-GROUP>
                          <SHORT-NAME>ProvidedEventgroup1</SHORT-NAME>
                          <EVENT-GROUP-REF DEST="SOMEIP-EVENT-GROUP">/katech/deployment/someip_local_map/SomeipEventgroup1</EVENT-GROUP-REF>
                          <MULTICAST-THRESHOLD>0</MULTICAST-THRESHOLD>
                        </SOMEIP-PROVIDED-EVENT-GROUP>
                        <SOMEIP-PROVIDED-EVENT-GROUP>
                          <SHORT-NAME>ProvidedEventgroup2</SHORT-NAME>
                          <EVENT-GROUP-REF DEST="SOMEIP-EVENT-GROUP">/katech/deployment/someip_local_map/SomeipEventgroup2</EVENT-GROUP-REF>
                          <MULTICAST-THRESHOLD>0</MULTICAST-THRESHOLD>
                        </SOMEIP-PROVIDED-EVENT-GROUP>
                      </PROVIDED-EVENT-GROUPS>
                      <SD-SERVER-CONFIG-REF DEST="SOMEIP-SD-SERVER-SERVICE-INSTANCE-CONFIG">/katech/SomeipSdTimingConfigs/SomeipSdServerServiceInstanceConfig</SD-SERVER-CONFIG-REF>
                      <SERVICE-INSTANCE-ID>801</SERVICE-INSTANCE-ID>
                    </PROVIDED-SOMEIP-SERVICE-INSTANCE>
                    <REQUIRED-SOMEIP-SERVICE-INSTANCE>
                      <SHORT-NAME>RequiredSomeipServiceInstance_local_map</SHORT-NAME>
                      <SERVICE-INTERFACE-DEPLOYMENT-REF DEST="SOMEIP-SERVICE-INTERFACE-DEPLOYMENT">/katech/deployment/someip_local_map</SERVICE-INTERFACE-DEPLOYMENT-REF>
                      <REQUIRED-EVENT-GROUPS>
                        <SOMEIP-REQUIRED-EVENT-GROUP>
                          <SHORT-NAME>RequiredEventgroup1</SHORT-NAME>
                          <EVENT-GROUP-REF DEST="SOMEIP-EVENT-GROUP">/katech/deployment/someip_local_map/SomeipEventgroup1</EVENT-GROUP-REF>
                        </SOMEIP-REQUIRED-EVENT-GROUP>
                        <SOMEIP-REQUIRED-EVENT-GROUP>
                          <SHORT-NAME>RequiredEventgroup2</SHORT-NAME>
                          <EVENT-GROUP-REF DEST="SOMEIP-EVENT-GROUP">/katech/deployment/someip_local_map/SomeipEventgroup2</EVENT-GROUP-REF>
                        </SOMEIP-REQUIRED-EVENT-GROUP>
                      </REQUIRED-EVENT-GROUPS>
                      <REQUIRED-MINOR-VERSION>0</REQUIRED-MINOR-VERSION>
                      <REQUIRED-SERVICE-INSTANCE-ID>801</REQUIRED-SERVICE-INSTANCE-ID>
                      <SD-CLIENT-CONFIG-REF DEST="SOMEIP-SD-CLIENT-SERVICE-INSTANCE-CONFIG">/katech/SomeipSdTimingConfigs/SomeipSdClientServiceInstanceConfig</SD-CLIENT-CONFIG-REF>
                      <VERSION-DRIVEN-FIND-BEHAVIOR>MINIMUM-MINOR-VERSION</VERSION-DRIVEN-FIND-BEHAVIOR>
                    </REQUIRED-SOMEIP-SERVICE-INSTANCE>
                  </ELEMENTS>
                </AR-PACKAGE>
              </AR-PACKAGES>
            </AR-PACKAGE>
          </AR-PACKAGES>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
