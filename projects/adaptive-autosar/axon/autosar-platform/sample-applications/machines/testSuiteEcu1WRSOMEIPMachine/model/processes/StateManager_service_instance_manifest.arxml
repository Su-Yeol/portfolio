<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00052.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>apd</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>Machines</SHORT-NAME>
          <AR-PACKAGES>
            <AR-PACKAGE>
              <SHORT-NAME>testSuiteEcu1WRSOMEIPMachine</SHORT-NAME>
              <AR-PACKAGES>
                <AR-PACKAGE>
                  <SHORT-NAME>ServiceInstanceToMachineMappings</SHORT-NAME>
                  <ELEMENTS>
                    <SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                      <SHORT-NAME>RoutineService_ProvidedServiceInstance_toMachine</SHORT-NAME>
                      <COMMUNICATION-CONNECTOR-REF DEST="ETHERNET-COMMUNICATION-CONNECTOR">/apd/MachineDesigns/testSuiteEcu1WRSOMEIPMachineDesign/CommunicationWRSOMEIPConnector1</COMMUNICATION-CONNECTOR-REF>
                      <SERVICE-INSTANCE-REFS>
                        <SERVICE-INSTANCE-REF DEST="PROVIDED-SOMEIP-SERVICE-INSTANCE">/apd/Machines/testSuiteEcu1WRSOMEIPMachine/ServiceInstances/RoutineService_ProvidedSomeipServiceInstance</SERVICE-INSTANCE-REF>
                      </SERVICE-INSTANCE-REFS>
                      <UDP-PORT-REF DEST="AP-APPLICATION-ENDPOINT">/apd/MachineDesigns/testSuiteEcu1WRSOMEIPMachineDesign/CommunicationWRSOMEIPConnector1/CmService1ApplicationEndpoint</UDP-PORT-REF>
                    </SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                    <SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                      <SHORT-NAME>StateMachineService_ProvidedServiceInstance_toMachine</SHORT-NAME>
                      <COMMUNICATION-CONNECTOR-REF DEST="ETHERNET-COMMUNICATION-CONNECTOR">/apd/MachineDesigns/testSuiteEcu1WRSOMEIPMachineDesign/CommunicationWRSOMEIPConnector1</COMMUNICATION-CONNECTOR-REF>
                      <SERVICE-INSTANCE-REFS>
                        <SERVICE-INSTANCE-REF DEST="PROVIDED-SOMEIP-SERVICE-INSTANCE">/apd/Machines/testSuiteEcu1WRSOMEIPMachine/ServiceInstances/StateMachineService_ProvidedSomeipServiceInstance</SERVICE-INSTANCE-REF>
                      </SERVICE-INSTANCE-REFS>
                      <TCP-PORT-REF DEST="AP-APPLICATION-ENDPOINT">/apd/MachineDesigns/testSuiteEcu1WRSOMEIPMachineDesign/CommunicationWRSOMEIPConnector1/StateMachineServiceApplicationEndpoint</TCP-PORT-REF>
                    </SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                    <SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                      <SHORT-NAME>TriggerIn_ProvidedServiceInstance_toMachine</SHORT-NAME>
                      <COMMUNICATION-CONNECTOR-REF DEST="ETHERNET-COMMUNICATION-CONNECTOR">/apd/MachineDesigns/testSuiteEcu1WRSOMEIPMachineDesign/CommunicationWRSOMEIPConnector1</COMMUNICATION-CONNECTOR-REF>
                      <SERVICE-INSTANCE-REFS>
                        <SERVICE-INSTANCE-REF DEST="PROVIDED-SOMEIP-SERVICE-INSTANCE">/apd/Machines/testSuiteEcu1WRSOMEIPMachine/ServiceInstances/TriggerIn_ProvidedSomeipServiceInstance</SERVICE-INSTANCE-REF>
                      </SERVICE-INSTANCE-REFS>
                      <UDP-PORT-REF DEST="AP-APPLICATION-ENDPOINT">/apd/MachineDesigns/testSuiteEcu1WRSOMEIPMachineDesign/CommunicationWRSOMEIPConnector1/TriggerApplicationEndpoint</UDP-PORT-REF>
                    </SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                    <SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                      <SHORT-NAME>TriggerInOut_ProvidedServiceInstance_toMachine</SHORT-NAME>
                      <COMMUNICATION-CONNECTOR-REF DEST="ETHERNET-COMMUNICATION-CONNECTOR">/apd/MachineDesigns/testSuiteEcu1WRSOMEIPMachineDesign/CommunicationWRSOMEIPConnector1</COMMUNICATION-CONNECTOR-REF>
                      <SERVICE-INSTANCE-REFS>
                        <SERVICE-INSTANCE-REF DEST="PROVIDED-SOMEIP-SERVICE-INSTANCE">/apd/Machines/testSuiteEcu1WRSOMEIPMachine/ServiceInstances/TriggerInOut_ProvidedSomeipServiceInstance</SERVICE-INSTANCE-REF>
                      </SERVICE-INSTANCE-REFS>
                      <UDP-PORT-REF DEST="AP-APPLICATION-ENDPOINT">/apd/MachineDesigns/testSuiteEcu1WRSOMEIPMachineDesign/CommunicationWRSOMEIPConnector1/TriggerApplicationEndpoint</UDP-PORT-REF>
                    </SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                    <SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                      <SHORT-NAME>TriggerOut_ProvidedServiceInstance_toMachine</SHORT-NAME>
                      <COMMUNICATION-CONNECTOR-REF DEST="ETHERNET-COMMUNICATION-CONNECTOR">/apd/MachineDesigns/testSuiteEcu1WRSOMEIPMachineDesign/CommunicationWRSOMEIPConnector1</COMMUNICATION-CONNECTOR-REF>
                      <SERVICE-INSTANCE-REFS>
                        <SERVICE-INSTANCE-REF DEST="PROVIDED-SOMEIP-SERVICE-INSTANCE">/apd/Machines/testSuiteEcu1WRSOMEIPMachine/ServiceInstances/TriggerOut_ProvidedSomeipServiceInstance</SERVICE-INSTANCE-REF>
                      </SERVICE-INSTANCE-REFS>
                      <UDP-PORT-REF DEST="AP-APPLICATION-ENDPOINT">/apd/MachineDesigns/testSuiteEcu1WRSOMEIPMachineDesign/CommunicationWRSOMEIPConnector1/TriggerApplicationEndpoint</UDP-PORT-REF>
                    </SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                    <SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                      <SHORT-NAME>UpdateAllowedService_ProvidedServiceInstance_toMachine</SHORT-NAME>
                      <COMMUNICATION-CONNECTOR-REF DEST="ETHERNET-COMMUNICATION-CONNECTOR">/apd/MachineDesigns/testSuiteEcu1WRSOMEIPMachineDesign/CommunicationWRSOMEIPConnector1</COMMUNICATION-CONNECTOR-REF>
                      <SERVICE-INSTANCE-REFS>
                        <SERVICE-INSTANCE-REF DEST="PROVIDED-SOMEIP-SERVICE-INSTANCE">/apd/Machines/testSuiteEcu1WRSOMEIPMachine/ServiceInstances/UpdateAllowedService_ProvidedSomeipServiceInstance</SERVICE-INSTANCE-REF>
                      </SERVICE-INSTANCE-REFS>
                      <TCP-PORT-REF DEST="AP-APPLICATION-ENDPOINT">/apd/MachineDesigns/testSuiteEcu1WRSOMEIPMachineDesign/CommunicationWRSOMEIPConnector1/UpdateAllowedServiceApplicationEndpoint</TCP-PORT-REF>
                    </SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                    <SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                      <SHORT-NAME>UpdateRequest_ProvidedServiceInstance_toMachine</SHORT-NAME>
                      <COMMUNICATION-CONNECTOR-REF DEST="ETHERNET-COMMUNICATION-CONNECTOR">/apd/MachineDesigns/testSuiteEcu1WRSOMEIPMachineDesign/CommunicationWRSOMEIPConnector1</COMMUNICATION-CONNECTOR-REF>
                      <SERVICE-INSTANCE-REFS>
                        <SERVICE-INSTANCE-REF DEST="PROVIDED-SOMEIP-SERVICE-INSTANCE">/apd/Machines/testSuiteEcu1WRSOMEIPMachine/ServiceInstances/UpdateRequest_ProvidedSomeipServiceInstance</SERVICE-INSTANCE-REF>
                      </SERVICE-INSTANCE-REFS>
                      <UDP-PORT-REF DEST="AP-APPLICATION-ENDPOINT">/apd/MachineDesigns/testSuiteEcu1WRSOMEIPMachineDesign/CommunicationWRSOMEIPConnector1/CmService1ApplicationEndpoint</UDP-PORT-REF>
                    </SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                  </ELEMENTS>
                </AR-PACKAGE>
                <AR-PACKAGE>
                  <SHORT-NAME>ServiceInstances</SHORT-NAME>
                  <ELEMENTS>
                    <PROVIDED-SOMEIP-SERVICE-INSTANCE>
                      <SHORT-NAME>RoutineService_ProvidedSomeipServiceInstance</SHORT-NAME>
                      <SERVICE-INTERFACE-DEPLOYMENT-REF DEST="SOMEIP-SERVICE-INTERFACE-DEPLOYMENT">/apd/ServiceInterfaceDeployments/RoutineService_Someip</SERVICE-INTERFACE-DEPLOYMENT-REF>
                      <!-- replace SERVICE-INSTANCE-ID to something more meaningful, 8899 is a placeholder -->
                      <SERVICE-INSTANCE-ID>8899</SERVICE-INSTANCE-ID>
                    </PROVIDED-SOMEIP-SERVICE-INSTANCE>
                    <PROVIDED-SOMEIP-SERVICE-INSTANCE>
                      <SHORT-NAME>StateMachineService_ProvidedSomeipServiceInstance</SHORT-NAME>
                      <SERVICE-INTERFACE-DEPLOYMENT-REF DEST="SOMEIP-SERVICE-INTERFACE-DEPLOYMENT">/apd/ServiceInterfaceDeployments/StateMachineService_Someip</SERVICE-INTERFACE-DEPLOYMENT-REF>
                      <SD-SERVER-CONFIG-REF DEST="SOMEIP-SD-SERVER-SERVICE-INSTANCE-CONFIG">/apd/SomeipSdTimingConfigs/SomeipSdServerServiceInstanceConfig</SD-SERVER-CONFIG-REF>
                      <SERVICE-INSTANCE-ID>670</SERVICE-INSTANCE-ID>
                    </PROVIDED-SOMEIP-SERVICE-INSTANCE>
                    <PROVIDED-SOMEIP-SERVICE-INSTANCE>
                      <SHORT-NAME>UpdateAllowedService_ProvidedSomeipServiceInstance</SHORT-NAME>
                      <SERVICE-INTERFACE-DEPLOYMENT-REF DEST="SOMEIP-SERVICE-INTERFACE-DEPLOYMENT">/apd/ServiceInterfaceDeployments/UpdateAllowedService_Someip</SERVICE-INTERFACE-DEPLOYMENT-REF>
                      <PROVIDED-EVENT-GROUPS>
                        <SOMEIP-PROVIDED-EVENT-GROUP>
                          <SHORT-NAME>ProvidedEventGroup</SHORT-NAME>
                          <EVENT-GROUP-REF DEST="SOMEIP-EVENT-GROUP">/apd/ServiceInterfaceDeployments/UpdateAllowedService_Someip/SomeIpEventGroup</EVENT-GROUP-REF>
                          <MULTICAST-THRESHOLD>2</MULTICAST-THRESHOLD>
                        </SOMEIP-PROVIDED-EVENT-GROUP>
                      </PROVIDED-EVENT-GROUPS>
                      <SD-SERVER-CONFIG-REF DEST="SOMEIP-SD-SERVER-SERVICE-INSTANCE-CONFIG">/apd/SomeipSdTimingConfigs/SomeipSdServerServiceInstanceConfig</SD-SERVER-CONFIG-REF>
                      <SERVICE-INSTANCE-ID>671</SERVICE-INSTANCE-ID>
                    </PROVIDED-SOMEIP-SERVICE-INSTANCE>
                    <PROVIDED-SOMEIP-SERVICE-INSTANCE>
                      <SHORT-NAME>UpdateRequest_ProvidedSomeipServiceInstance</SHORT-NAME>
                      <SERVICE-INTERFACE-DEPLOYMENT-REF DEST="SOMEIP-SERVICE-INTERFACE-DEPLOYMENT">/apd/ServiceInterfaceDeployments/UpdateRequest_Someip</SERVICE-INTERFACE-DEPLOYMENT-REF>
                      <SD-SERVER-CONFIG-REF DEST="SOMEIP-SD-SERVER-SERVICE-INSTANCE-CONFIG">/apd/SomeipSdTimingConfigs/SomeipSdServerServiceInstanceConfig</SD-SERVER-CONFIG-REF>
                      <SERVICE-INSTANCE-ID>669</SERVICE-INSTANCE-ID>
                    </PROVIDED-SOMEIP-SERVICE-INSTANCE>
                    <PROVIDED-SOMEIP-SERVICE-INSTANCE>
                      <SHORT-NAME>TriggerInOut_ProvidedSomeipServiceInstance</SHORT-NAME>
                      <SERVICE-INTERFACE-DEPLOYMENT-REF DEST="SOMEIP-SERVICE-INTERFACE-DEPLOYMENT">/apd/ServiceInterfaceDeployments/TriggerInOut_Someip</SERVICE-INTERFACE-DEPLOYMENT-REF>
                      <PROVIDED-EVENT-GROUPS>
                        <SOMEIP-PROVIDED-EVENT-GROUP>
                          <SHORT-NAME>ProvidedEventGroup</SHORT-NAME>
                          <EVENT-GROUP-REF DEST="SOMEIP-EVENT-GROUP">/apd/ServiceInterfaceDeployments/TriggerInOut_Someip/SomeIpEventGroup</EVENT-GROUP-REF>
                          <MULTICAST-THRESHOLD>2</MULTICAST-THRESHOLD>
                        </SOMEIP-PROVIDED-EVENT-GROUP>
                      </PROVIDED-EVENT-GROUPS>
                      <SD-SERVER-CONFIG-REF DEST="SOMEIP-SD-SERVER-SERVICE-INSTANCE-CONFIG">/apd/SomeipSdTimingConfigs/SomeipSdServerServiceInstanceConfig</SD-SERVER-CONFIG-REF>
                      <SERVICE-INSTANCE-ID>669</SERVICE-INSTANCE-ID>
                    </PROVIDED-SOMEIP-SERVICE-INSTANCE>
                    <PROVIDED-SOMEIP-SERVICE-INSTANCE>
                      <SHORT-NAME>TriggerIn_ProvidedSomeipServiceInstance</SHORT-NAME>
                      <SERVICE-INTERFACE-DEPLOYMENT-REF DEST="SOMEIP-SERVICE-INTERFACE-DEPLOYMENT">/apd/ServiceInterfaceDeployments/TriggerIn_Someip</SERVICE-INTERFACE-DEPLOYMENT-REF>
                      <SD-SERVER-CONFIG-REF DEST="SOMEIP-SD-SERVER-SERVICE-INSTANCE-CONFIG">/apd/SomeipSdTimingConfigs/SomeipSdServerServiceInstanceConfig</SD-SERVER-CONFIG-REF>
                      <SERVICE-INSTANCE-ID>49</SERVICE-INSTANCE-ID>
                    </PROVIDED-SOMEIP-SERVICE-INSTANCE>
                    <PROVIDED-SOMEIP-SERVICE-INSTANCE>
                      <SHORT-NAME>TriggerOut_ProvidedSomeipServiceInstance</SHORT-NAME>
                      <SERVICE-INTERFACE-DEPLOYMENT-REF DEST="SOMEIP-SERVICE-INTERFACE-DEPLOYMENT">/apd/ServiceInterfaceDeployments/TriggerOut_Someip</SERVICE-INTERFACE-DEPLOYMENT-REF>
                      <PROVIDED-EVENT-GROUPS>
                        <SOMEIP-PROVIDED-EVENT-GROUP>
                          <SHORT-NAME>ProvidedEventGroup</SHORT-NAME>
                          <EVENT-GROUP-REF DEST="SOMEIP-EVENT-GROUP">/apd/ServiceInterfaceDeployments/TriggerOut_Someip/SomeIpEventGroup</EVENT-GROUP-REF>
                          <MULTICAST-THRESHOLD>2</MULTICAST-THRESHOLD>
                        </SOMEIP-PROVIDED-EVENT-GROUP>
                      </PROVIDED-EVENT-GROUPS>
                      <SD-SERVER-CONFIG-REF DEST="SOMEIP-SD-SERVER-SERVICE-INSTANCE-CONFIG">/apd/SomeipSdTimingConfigs/SomeipSdServerServiceInstanceConfig</SD-SERVER-CONFIG-REF>
                      <SERVICE-INSTANCE-ID>668</SERVICE-INSTANCE-ID>
                    </PROVIDED-SOMEIP-SERVICE-INSTANCE>
                  </ELEMENTS>
                </AR-PACKAGE>
              </AR-PACKAGES>
            </AR-PACKAGE>
          </AR-PACKAGES>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
