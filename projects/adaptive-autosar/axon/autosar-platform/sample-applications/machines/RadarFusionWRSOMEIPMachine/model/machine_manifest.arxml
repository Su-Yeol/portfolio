                  </ENVIRONMENT-VARIABLES>
                  <MACHINE-DESIGN-REF DEST="MACHINE-DESIGN">/apd/MachineDesigns/RadarFusionWRSOMEIPMachineDesign</MACHINE-DESIGN-REF>
