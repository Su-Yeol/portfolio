                    </SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                  </ELEMENTS>
                </AR-PACKAGE>
                <AR-PACKAGE>
                  <SHORT-NAME>ServiceInstances</SHORT-NAME>
                  <ELEMENTS>
                    <REQUIRED-SOMEIP-SERVICE-INSTANCE>
                      <SHORT-NAME>CMValidatorSubscriberRequiredSomeipServiceInstance</SHORT-NAME>
                      <E-2-E-EVENT-PROTECTION-PROPSS>
                        <END-2-END-EVENT-PROTECTION-PROPS>
                          <SHORT-NAME>End2EndEventProtectionProps</SHORT-NAME>
                          <DATA-IDS>
                            <DATA-ID>4321</DATA-ID>
                          </DATA-IDS>
                          <E-2-E-PROFILE-CONFIGURATION-REF DEST="E-2-E-PROFILE-CONFIGURATION">/apd/Machines/RadarFusionWRSOMEIPMachine/E2E/e2eprofiles/PROFILE_01</E-2-E-PROFILE-CONFIGURATION-REF>
                          <EVENT-REF DEST="SOMEIP-EVENT-DEPLOYMENT">/apd/ServiceInterfaceDeployments/CMValidatorPublisher_Someip/Event1_Someip</EVENT-REF>
                          <MAX-DATA-LENGTH>4096</MAX-DATA-LENGTH>
                          <MIN-DATA-LENGTH>1</MIN-DATA-LENGTH>
                        </END-2-END-EVENT-PROTECTION-PROPS>
                        <END-2-END-EVENT-PROTECTION-PROPS>
                          <SHORT-NAME>End2EndEventProtectionProps</SHORT-NAME>
                          <DATA-IDS>
                            <DATA-ID>4321</DATA-ID>
                            <DATA-ID>4321</DATA-ID>
                          </DATA-IDS>
                          <E-2-E-PROFILE-CONFIGURATION-REF DEST="E-2-E-PROFILE-CONFIGURATION">/apd/Machines/RadarFusionWRSOMEIPMachine/E2E/e2eprofiles/PROFILE_01</E-2-E-PROFILE-CONFIGURATION-REF>
                          <EVENT-REF DEST="SOMEIP-EVENT-DEPLOYMENT">/apd/ServiceInterfaceDeployments/CMValidatorPublisher_Someip/Event2_Someip</EVENT-REF>
                          <MAX-DATA-LENGTH>4096</MAX-DATA-LENGTH>
                          <MIN-DATA-LENGTH>1</MIN-DATA-LENGTH>
                        </END-2-END-EVENT-PROTECTION-PROPS>
                      </E-2-E-EVENT-PROTECTION-PROPSS>
                      <SERVICE-INTERFACE-DEPLOYMENT-REF DEST="SOMEIP-SERVICE-INTERFACE-DEPLOYMENT">/apd/ServiceInterfaceDeployments/CMValidatorPublisher_Someip</SERVICE-INTERFACE-DEPLOYMENT-REF>
                      <REQUIRED-EVENT-GROUPS>
                        <SOMEIP-REQUIRED-EVENT-GROUP>
                          <SHORT-NAME>RequiredEventgroup1</SHORT-NAME>
                          <EVENT-GROUP-REF DEST="SOMEIP-EVENT-GROUP">/apd/ServiceInterfaceDeployments/CMValidatorPublisher_Someip/SomeipEventgroup1</EVENT-GROUP-REF>
                        </SOMEIP-REQUIRED-EVENT-GROUP>
                        <SOMEIP-REQUIRED-EVENT-GROUP>
                          <SHORT-NAME>RequiredEventgroup2</SHORT-NAME>
                          <EVENT-GROUP-REF DEST="SOMEIP-EVENT-GROUP">/apd/ServiceInterfaceDeployments/CMValidatorPublisher_Someip/SomeipEventgroup2</EVENT-GROUP-REF>
                        </SOMEIP-REQUIRED-EVENT-GROUP>
                      </REQUIRED-EVENT-GROUPS>
                      <REQUIRED-MINOR-VERSION>0</REQUIRED-MINOR-VERSION>
                      <REQUIRED-SERVICE-INSTANCE-ID>88</REQUIRED-SERVICE-INSTANCE-ID>
                      <SD-CLIENT-CONFIG-REF DEST="SOMEIP-SD-CLIENT-SERVICE-INSTANCE-CONFIG">/apd/SomeipSdTimingConfigs/SomeipSdClientServiceInstanceConfig</SD-CLIENT-CONFIG-REF>
                      <VERSION-DRIVEN-FIND-BEHAVIOR>MINIMUM-MINOR-VERSION</VERSION-DRIVEN-FIND-BEHAVIOR>
                    </REQUIRED-SOMEIP-SERVICE-INSTANCE>
                  </ELEMENTS>
                </AR-PACKAGE>
