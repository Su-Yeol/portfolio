  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>apd</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>Machines</SHORT-NAME>
          <AR-PACKAGES>
            <AR-PACKAGE>
              <SHORT-NAME>RadarFusionWRSOMEIPMachine</SHORT-NAME>
              <AR-PACKAGES>
                <AR-PACKAGE>
                  <SHORT-NAME>ServiceInstanceToMachineMappings</SHORT-NAME>
                  <ELEMENTS>
                    <SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
                      <SHORT-NAME>CMValidatorSubscriber_RequiredServiceInstance_toMachine</SHORT-NAME>
                      <COMMUNICATION-CONNECTOR-REF DEST="ETHERNET-COMMUNICATION-CONNECTOR">/apd/MachineDesigns/RadarFusionWRSOMEIPMachineDesign/RadarFusionWRSOMEIPConnector</COMMUNICATION-CONNECTOR-REF>
                      <SERVICE-INSTANCE-REFS>
                        <SERVICE-INSTANCE-REF DEST="REQUIRED-SOMEIP-SERVICE-INSTANCE">/apd/Machines/RadarFusionWRSOMEIPMachine/ServiceInstances/CMValidatorSubscriberRequiredSomeipServiceInstance</SERVICE-INSTANCE-REF>
                      </SERVICE-INSTANCE-REFS>
