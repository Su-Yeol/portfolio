                <DOCUMENTATION>
                  <SHORT-NAME>@CSWPP_NAME@SwpkgInstallUpdatePurpose</SHORT-NAME>
                  <DOCUMENTATION-CONTENT>
                    <P>
                      <L-1 L="EN">Install the @CSWPP_NAME@ app application</L-1>
                    </P>
                  </DOCUMENTATION-CONTENT>
                </DOCUMENTATION>
              </ELEMENTS>
            </AR-PACKAGE>
          </AR-PACKAGES>
        </AR-PACKAGE>
