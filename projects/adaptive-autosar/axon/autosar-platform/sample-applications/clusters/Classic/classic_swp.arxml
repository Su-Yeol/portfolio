<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://autosar.org/schema/r4.0" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00052.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>apd</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>SoftwarePackages</SHORT-NAME>
          <AR-PACKAGES>
            <AR-PACKAGE>
              <SHORT-NAME>@CSWPP_NAME@</SHORT-NAME>
              <ELEMENTS>
                <SOFTWARE-PACKAGE>
                  <SHORT-NAME>@CSWPP_NAME@SwpkgInstall</SHORT-NAME>
                  <ACTION-TYPE>INSTALL</ACTION-TYPE>
                  <ACTIVATION-ACTION>NOTHING</ACTIVATION-ACTION>
                  <COMPRESSED-SOFTWARE-PACKAGE-SIZE>0</COMPRESSED-SOFTWARE-PACKAGE-SIZE>
                  <ESTIMATED-DURATION-OF-OPERATION>42</ESTIMATED-DURATION-OF-OPERATION>
                  <MINIMUM-SUPPORTED-UCM-VERSION>1.0.0_0</MINIMUM-SUPPORTED-UCM-VERSION>
                  <PACKAGER-ID>1347111236</PACKAGER-ID>
                  <PURPOSE-OF-UPDATE-REF DEST="DOCUMENTATION">/apd/SoftwarePackages/@CSWPP_NAME@/@CSWPP_NAME@SwpkgInstallUpdatePurpose</PURPOSE-OF-UPDATE-REF>
                  <SOFTWARE-CLUSTER-REF DEST="SOFTWARE-CLUSTER">/apd/SoftwareClusters/@CSWCL_NAME@/@CSWCL_NAME@Swcl</SOFTWARE-CLUSTER-REF>
                  <UNCOMPRESSED-SOFTWARE-CLUSTER-SIZE>16384</UNCOMPRESSED-SOFTWARE-CLUSTER-SIZE>
