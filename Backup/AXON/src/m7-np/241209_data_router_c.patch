+// can2 - 0x165
+void TxCAN2_ADAS_PRK_20_20ms(void)
+{
+	char k = 0;
+	static uint8 _SPASStatus;
+	static uint8 whl_cnt=0;
+	DB_IONIQ_RxCAN2_Unknown_0x377 *DB_CAN2_Unknown_0x377_ptr;
+	DB_IONIQ_RxCAN2_MDPS_01_10ms *DB1;
+	DB_IONIQ_RxCAN0_SAS_01_10ms *DB2;
+	DB_IONIQ_RxCAN0_SAS_01_10ms *testDB;
+	DB_IONIQ_RxCAN1_SWRC_03_20ms *DB_CAN1_SWRC_03_20ms_ptr;
+	KATECH_CONTROL_A2V *interface_db;
+
+	int16 TargetAngCmd = 0, int16tmp;
+	float RealAng, TargetAng, FloatTmp;
+	static float OldTargetAng=0;
+	static int16 old_TargetAngCmd=0;
+
+	// DB_CAN2_Unknown_0x377_ptr = katech_database_read_addr_get(KATECH_NAME_DB_IONIQ_RxCAN2_Unknown_0x377);
+	DB1=katech_database_read_addr_get(KATECH_NAME_DB_IONIQ_RxCAN2_MDPS_01_10ms);
+	DB2=katech_database_read_addr_get(KATECH_NAME_DB_IONIQ_RxCAN0_SAS_01_10ms);
+	interface_db=katech_get_addr_vehicle_interface_control(); // recv data using ipcf
+	// random value: interface_db = 0;
+	DB_CAN1_SWRC_03_20ms_ptr = katech_database_read_addr_get(KATECH_NAME_DB_IONIQ_RxCAN1_SWRC_03_20ms);
+
+	if(katech_adas_mode == 1)
+	{
+		_SPASStatus = g_SPASStatus;
+
+		if (DB1->MDPS_PaModeSta == 3) _SPASStatus = 4;
+		else if (DB1->MDPS_PaModeSta == 4) _SPASStatus = 5;
+		else if (DB1->MDPS_PaModeSta == 5) _SPASStatus = 5;
+		else if (DB1->MDPS_PaModeSta == 6) _SPASStatus = 2;
+		else _SPASStatus = 3;
+
+		g_SPASStatus = _SPASStatus;
+		TargetAng = interface_db->SteeringAngle;
+		RealAng = DB2->StrAngle;
+
+		if(DB1->MDPS_PaModeSta == 5)
+		{
+			if(whl_cnt<5)
+			{
+				TargetAngCmd=RealAng*10;
+				OldTargetAng=RealAng;
+				whl_cnt++;
+			}
+			else
+			{
+				if(TargetAng>540) TargetAng=540;
+				else if(TargetAng<-540)TargetAng=-540;
+
+				FloatTmp = TargetAng-RealAng;
+				if(FloatTmp>20) FloatTmp=RealAng+30;
+				else if(FloatTmp<-20) FloatTmp=RealAng-30;
+				else  FloatTmp= TargetAng;
+				TargetAngCmd=(int16_t)(FloatTmp*10);
+				OldTargetAng=FloatTmp;
+			}
+		}
+		else if(DB1->MDPS_PaModeSta < 5)
+		{
+			old_TargetAngCmd=RealAng*10;
+			TargetAngCmd=RealAng*10;
+
+		}
+
+		if(DB1->MDPS_PaModeSta > 5)
+		{
+			katech_adas_mode=-1;
+
+		}
+	}
+	else
+	{
+		_SPASStatus = 3;
+		whl_cnt=0;
+		TargetAngCmd=RealAng*10;
+	}
+
+
+	ADAS_PRK_20_TxData[2] = ADAS_PRK_20_AlvCnt;
+	if(ADAS_PRK_20_AlvCnt == 0xff)
+		ADAS_PRK_20_AlvCnt = 0;
+	ADAS_PRK_20_AlvCnt++;
+
+	if(_SPASStatus == 5)
+		ADAS_PRK_20_TxData[3] = 0x4B;
+	else
+		ADAS_PRK_20_TxData[3] = 0x48;
+
+	ADAS_PRK_20_TxData[4] = 0x00;
+	ADAS_PRK_20_TxData[5] = 0x00;
+	ADAS_PRK_20_TxData[6] = 0x00;
+	ADAS_PRK_20_TxData[7] = 0x00;
+	ADAS_PRK_20_TxData[8] = 0x00;
+	ADAS_PRK_20_TxData[9] = 0x00;
+	ADAS_PRK_20_TxData[10] = 0x00;
+	ADAS_PRK_20_TxData[11] = (_SPASStatus << 2)&0x3C;
+	ADAS_PRK_20_TxData[12] = TargetAngCmd & 0xff;
+	ADAS_PRK_20_TxData[13] = TargetAngCmd >> 8;
+	ADAS_PRK_20_TxData[14] = 0x02;
+	ADAS_PRK_20_TxData[15] = 0x00;
+	ADAS_PRK_20_TxData[16] = 0x00;
+	ADAS_PRK_20_TxData[17] = 0x00;
+	ADAS_PRK_20_TxData[18] = 0x00;
+	ADAS_PRK_20_TxData[19] = 0x00;
+	ADAS_PRK_20_TxData[20] = 0x00;
+	ADAS_PRK_20_TxData[21] = 0x00;
+	ADAS_PRK_20_TxData[22] = 0x00;
+	ADAS_PRK_20_TxData[23] = 0x00;
+
+	for (k=2; k<24; k++)
+	{
+		i8_index = (uint8)((crc>>8)^ADAS_PRK_20_TxData[k]) & 0x00FF;
+		crc = (crc<<8)^crc16table[i8_index];
+	}
+	crc = (crc<<8)^crc16table[(uint8)((crc>>8)^DataID_L) & 0x00FF];
+	crc = (crc<<8)^crc16table[(uint8)((crc>>8)^DataID_H) & 0x00FF];
+
+	ADAS_PRK_20_TxData[0] = crc & 0x00FF;
+	ADAS_PRK_20_TxData[1] = (crc & 0xFF00) >> 8;
+
+	frm_lpa_sendFrame(FRAME_TYPE_CANFD_BASE, 3, 0x165, 24, ADAS_PRK_20_TxData);
+
+	crc = 0xFFFF;
+}
