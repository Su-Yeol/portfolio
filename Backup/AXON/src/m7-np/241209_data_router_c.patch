+//can1 -0x160 (can3 - m7 - can1)
+//AEB
+void TxCAN1_ADAS_CMD_10_20ms(void)
+{
+	uint8 Msg160_DataID_H = 0xF9;
+	uint8 Msg160_DataID_L = 0x60;
+	uint32 Msg160_CRC = 0xFFFF;
+	uint8 Msg160_Length = 16;
+	uint16 Msg160_index = 0;
+	char i_160 = 0;
+
+	uint8 TempArray160[16];
+	static uint8 AliveAEBCnt = 0; // Alive Count
+	uint8 CRCDataHigh = 0;
+	uint8 CRCDataLow = 0;
+	uint8 FCA_WrngLvlSta = 0; // 0 -> 1 -> 2
+	uint8 FCA_SysFlrSta = 0;
+	uint8 FCA_HydrlcBstAsstlSta = 0;
+	uint8 FCA_StbltActvReq = 0;
+	uint8 FCA_DclReqVal = 0; // 0 -> 4[g]
+	uint8 FCA_FullActvReq = 0;
+	uint8 FCA_PartialActvReq = 0; // 0 -> 1
+	uint8 FCA_WrngSndSta = 0; // 0 -> 2
+	uint8 FCA_SnstvtyModRetVal = 2;
+	uint16 FCA_RelVel = 0xFF;     // FF > 117
+	uint8 FCA_TimetoCllsn = 0xFE; // FE > 57
+	uint8 Nmode_FCAOff_Sta = 0;
+	uint8 FCA_Jnctn_OnOffEquipSta = 2;
+	uint8 ADAS_DRV_FCA_Plus_Sta = 0;
+	uint8 FCA_WrngTrgtDis = 0; // 0 -> 5
+	uint8 FCA_OnOffEquipSta = 3;
+	uint8 FCA_VehStpReq = 0;
+	uint8 FCA_PrefillActvReq = 0;
+
+
+	FCA_RelVel = 0x117;
+	FCA_TimetoCllsn = 0x57;
+	FCA_DclReqVal = 90; // 40 = 0.4g, 60 = 0.6g etc
+
+	FCA_WrngLvlSta = 2;
+	FCA_WrngSndSta = 2;
+	FCA_WrngTrgtDis = 5;
+	FCA_PrefillActvReq = 0;
+	// FCA_PartialActvReq = 1;
+	FCA_FullActvReq = 1; // 0.6g 
+	FCA_HydrlcBstAsstlSta = 3;
+	FCA_StbltActvReq = 2;
+	FCA_RelVel = 0xFF;
+	FCA_TimetoCllsn = 0xFE;
+	FCA_DclReqVal = 0;
+	FCA_WrngLvlSta = 0;
+	FCA_WrngSndSta = 0;
+	FCA_WrngTrgtDis = 0;
+	FCA_PartialActvReq = 0;
+	FCA_PrefillActvReq = 0;
+	FCA_HydrlcBstAsstlSta = 0;
+
+	TempArray160[0] = CRCDataHigh; // CRC High byte
+	TempArray160[1] = CRCDataLow;  // CRC Low byte
+	TempArray160[2] = AliveAEBCnt++;    // Alive count
+	TempArray160[3] = (0xC0 & (FCA_WrngLvlSta << 6)) + (0x38 & (FCA_SysFlrSta << 3)) + (0x07 & (FCA_OnOffEquipSta));
+	TempArray160[4] = (0x60 & (FCA_HydrlcBstAsstlSta << 5)) + (0x1C & (FCA_StbltActvReq << 2)) + (0x03 & (FCA_VehStpReq));
+	TempArray160[5] = FCA_DclReqVal;
+	TempArray160[6] = (0x30 & (FCA_FullActvReq << 4)) + (0x0C & (FCA_PartialActvReq << 2)) + (0x03 & (FCA_PrefillActvReq));
+	TempArray160[7] = (0xE0 & (FCA_WrngSndSta << 5)) + (0x07 & (FCA_SnstvtyModRetVal));
+	TempArray160[8] = (0xFF & (FCA_RelVel));
+	TempArray160[9] = (0xFE & (FCA_TimetoCllsn << 1)) + (0x01 & (FCA_RelVel >> 8));
+	TempArray160[10] = (0x18 & (FCA_Jnctn_OnOffEquipSta << 3)) + (0x06 & (Nmode_FCAOff_Sta << 1)) + (0x01 & (FCA_TimetoCllsn >> 7));
+	TempArray160[11] = (0x60 & (ADAS_DRV_FCA_Plus_Sta << 5)) + (0x1F & (FCA_WrngTrgtDis));
+	TempArray160[12] = 0x00;
+	TempArray160[13] = 0x00;
+	TempArray160[14] = 0x00;
+	TempArray160[15] = 0x00;
+
+	for (i_160=2; i_160 < Msg160_Length; i_160++)
+	{
+		Msg160_index = (uint8)((Msg160_CRC >> 8)^(TempArray160[i_160]) & 0x00FF);
+		Msg160_CRC  = (Msg160_CRC <<8)^crc16table[Msg160_index];
+	}
+	Msg160_CRC = (Msg160_CRC<<8)^crc16table[(uint8)((Msg160_CRC>>8)^Msg160_DataID_L) & 0x00FF];
+	Msg160_CRC = (Msg160_CRC<<8)^crc16table[(uint8)((Msg160_CRC>>8)^Msg160_DataID_H) & 0x00FF];
+
+	TempArray160[0] = Msg160_CRC & 0x00FF;
+	TempArray160[1] = (Msg160_CRC & 0xFF00) >> 8;
+
+	frm_lpa_sendFrame(FRAME_TYPE_CANFD_BASE, 2, 0x160, 16, TempArray160);
+
+	Msg160_CRC = 0xFFFF;
+}
