+	DB_IONIQ_RxCAN1_SWRC_03_20ms *DB_CAN1_SWRC_03_20ms_ptr;
+	DB_IONIQ_RxCAN3_ADAS_CMD_32_50ms *DB_IONIQ_RxCAN3_ADAS_CMD_20_20ms_ptr;
