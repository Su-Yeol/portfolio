+			SCC_AccelReqVal=1023;
+		}
+		else if(SCC_AccelReqVal>1023)
+		{
+			SCC_VehStpReq=0;
+		}
+
+		if((DB_IONIQ_RxCAN0_CLU_01_20ms_ptr->DisplaySpd>=MAX_SPEED)&&(SCC_AccelReqVal>1023))
+		{
+			SCC_AccelReqVal=1023;
+		}
+	}
+	else
+	{
+		SCC_OpSta = 0;
+		SCC_MainOnOffSta = 0;
+		SCC_JrkUpp = 25;
+		SCC_JrkLwr = 10;
+		SCC_AccelReqVal = 1023; // 0.1m/s^2 1113<->680(0.9m/s^2<->-3.43m/s^2); max(1113), min(680);=
+		SCC_TrgtSpdSetVal = MAX_SPEED;
+		SCC_VehStpReq = 0;
+	}
+	SCC_AccelReqRawVal=SCC_AccelReqVal;
+
+
+	if((DB_CAN1_ESC_03_20ms_ptr->PrkBrakeAct  == 1) || (DB_CAN0_IEB_01_10ms_ptr->BrakeAct > 5) || (DB_CAN1_Unknown_0x35_ptr->AccelAct > 5)||(katech_adas_mode<0))
+	{
+		SCC_OpSta = 0;
+		SCC_MainOnOffSta = 0;
+		SCC_JrkUpp = 25;
+		SCC_JrkLwr = 10;
+		SCC_AccelReqVal = 1023; // 0.1m/s^2 1113<->680(0.9m/s^2<->-3.43m/s^2); max(1113), min(680);
+		SCC_AccelReqRawVal = 1023;
+		SCC_TrgtSpdSetVal = MAX_SPEED;
+		SCC_VehStpReq = 0;
+		katech_adas_mode=0;
+	}
+
+	TempArray1A0_Ptr = TempArray1A0[pos];
+
+	TempArray1A0_Ptr[12] = SCC_TrgtSpdSetVal;
+	TempArray1A0_Ptr[8] = ((SCC_OpSta << 4) + (SCC_MainOnOffSta << 2));
+
+	TempArray1A0_Ptr[2] = Msg1A0cnt; // 0x1A0 Msg AliveCount (0x00 ~ 0xFF)
+	Msg1A0cnt++;
+	if(Msg1A0cnt > 0xFF)
+		Msg1A0cnt = 0;
+
+	TempArray1A0_Ptr[16] = SCC_AccelReqVal & 0xff;
+	TempArray1A0_Ptr[17] = ((SCC_AccelReqRawVal & 0x0f) << 4) + ((SCC_AccelReqVal >> 8) & 0x07);
+	TempArray1A0_Ptr[18] = (SCC_AccelReqRawVal >> 4) & 0x7f;
+	TempArray1A0_Ptr[19] = SCC_JrkUpp;
+	TempArray1A0_Ptr[20] = SCC_JrkLwr;
+	TempArray1A0_Ptr[23] = (SCC_VehStpReq & 0x03);
+
+	for (i_1A0=2; i_1A0 < Msg1A0_Length; i_1A0++)
+	{
+		Msg1A0_index = (uint8)((Msg1A0_CRC >> 8)^TempArray1A0_Ptr[i_1A0]) & 0x00FF;
+		Msg1A0_CRC  = (Msg1A0_CRC <<8)^crc16table[Msg1A0_index];
+	}
+	Msg1A0_CRC = (Msg1A0_CRC<<8)^crc16table[(uint8)((Msg1A0_CRC>>8)^Msg1A0_DataID_L) & 0x00FF];
+	Msg1A0_CRC = (Msg1A0_CRC<<8)^crc16table[(uint8)((Msg1A0_CRC>>8)^Msg1A0_DataID_H) & 0x00FF];
+
+	TempArray1A0_Ptr[0] = Msg1A0_CRC & 0x00FF;
+	TempArray1A0_Ptr[1] = (Msg1A0_CRC & 0xFF00) >> 8;
+
+	frm_lpa_sendFrame(FRAME_TYPE_CANFD_BASE, 2, 0x1a0, 32, TempArray1A0_Ptr);
+	Msg1A0_CRC = 0xFFFF;
+}
