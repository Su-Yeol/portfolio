+	if (dbaddr->ThisCurvatureRateL > 32767)
+		dbaddr->ThisCurvatureRateL = dbaddr->ThisCurvatureRateL - 65535;
+	dbaddr->CurvatureRateL = dbaddr->ThisCurvatureRateL * 0.0000000020; //실제DBC Factor 0.000000004 보다 1/2
