+/*
+ * MCU TX to CAN2(MDPS)
+ */
+// can2 - 0xA0 (can0, can1 - m7 - can2)
+void TxCAN2_WHL_01_10ms(void)
+{
+	DB_IONIQ_RxCAN2_Unknown_0x377 *DB_CAN2_Unknown_0x377_ptr;
+
+	DB_CAN2_Unknown_0x377_ptr = katech_database_read_addr_get(KATECH_NAME_DB_IONIQ_RxCAN2_Unknown_0x377);
+	SPASStatus = g_SPASStatus;
+	WHL_01_10_TxData[2] = WHL_AlvCnt;
+	if(WHL_AlvCnt == 0xff)
+		WHL_AlvCnt = 0;
+	WHL_AlvCnt++;
+
+	for(uint8 i=3; i<24; i++)
+	{
+		if(i >= 8 && i <= 15) // 5kph
+		{
+			if(i % 2 == 0)
+			{
+				if(SPASStatus == 4)
+					WHL_01_10_TxData[i] = 0;
+				else if((SPASStatus == 3) || (SPASStatus == 5))
+					WHL_01_10_TxData[i] = 25;
+			}
+			else
+				WHL_01_10_TxData[i] = 0;
+		}
+		else
+			WHL_01_10_TxData[i] = 0;
+	}
+	WHL_01_10_TxData[17] = 0x40;
+	WHL_01_10_TxData[18] = 0x01;
+
+	for (uint8 j=2; j<24; j++)
+	{
+		WHLCRC16Table = (uint8_t)((WHL_CRC>>8)^WHL_01_10_TxData[j]) & 0x00FF;
+		WHL_CRC = (WHL_CRC<<8)^crc16table[WHLCRC16Table];
+	}
+	WHL_CRC = (WHL_CRC<<8)^crc16table[(uint8_t)((WHL_CRC>>8)^DataID_L_WHL) & 0x00FF];
+	WHL_CRC = (WHL_CRC<<8)^crc16table[(uint8_t)((WHL_CRC>>8)^DataID_H_WHL) & 0x00FF];
+
+	WHL_01_10_TxData[0] = WHL_CRC & 0x00FF;
+	WHL_01_10_TxData[1] = (WHL_CRC & 0xFF00) >> 8;
+
+	frm_lpa_sendFrame(FRAME_TYPE_CANFD_BASE, 3, 0xA0, 24, WHL_01_10_TxData);
+
+	WHL_CRC = 0xFFFF;
+}
